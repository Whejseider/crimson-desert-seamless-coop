# Normalize text files in the repository
* text=auto

# Windows files: the readmes and profiles of the packages, scripts
kit/** text eol=crlf
# The INI profiles are UTF-16: a CRLF conversion inserts single bytes and breaks
# the encoding (Co-op+ fix, patch 0003). Keep them byte-for-byte.
kit/**/cdmp.ini* -text
*.ps1 text eol=crlf

# Binaries
*.dll binary
*.webp binary
*.png binary
