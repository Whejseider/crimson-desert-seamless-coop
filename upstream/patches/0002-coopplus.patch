+    if (g_ch.state != kChOn || game_of(g_ch.stage) != kGameRps) return v;
+    v.on = true;
+    const uint32_t now = GetTickCount();
+    if (static_cast<int32_t>(now - g_rps.reveal_until) < 0) {
