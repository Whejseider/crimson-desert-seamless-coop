+#include "mod/net/puppet_visibility.h"
+
+#include <windows.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include <safetyhook.hpp>
+
+#include "mod/game/offsets.h"
