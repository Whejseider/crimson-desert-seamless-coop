+        // when it enters the new one.)
+        if (end.kind != Kind::Join) net::room_leave();
+    }
+    log::info("Network stopped ({})", end.kind == Kind::Join    ? "joining another world"
+                                      : end.kind == Kind::Leave ? "left the other player's world"
+                                                                : "mod stopping");
+    return end;
+}
