@@ -0,0 +1,314 @@
+#include "mod/net/steam_join.h"
+
+#include <windows.h>
+
+#include <atomic>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string_view>
+
+#include "mod/log.h"
