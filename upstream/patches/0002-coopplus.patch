+        v.reveal_t = static_cast<float>(kRpsRevealMs - (g_rps.reveal_until - now)) / 1000.0f;
+    } else {
+        v.ours_picked = g_rps.ours >= 0;
+        v.theirs_picked = g_rps.theirs >= 0;
+    }
+    return v;
+}
