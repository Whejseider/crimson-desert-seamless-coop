diff --git a/upstream/cd-coop-3446/src/mod/net/party_quests.cpp b/upstream/cd-coop-3446/src/mod/net/party_quests.cpp
new file mode 100644
index 0000000..a55aa5a
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/party_quests.cpp
@@ -0,0 +1,140 @@
+#include "mod/net/party_quests.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <cstring>
+#include <deque>
+#include <format>
+#include <iterator>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+
+namespace cdmp::net {
+namespace {
+
+struct MissionName {
+    uint32_t key;
+    char kind;  // 'M' mission, 'C' challenge, 'O' other
+    const char* name;
+};
+constexpr MissionName kNames[] = {
+#include "mod/net/mission_names.inc"
+};
+
+constexpr uint16_t kOpUpdateMissionListAck = 2360;
+constexpr uint8_t kQuestType = 13;  // Activity event type
+constexpr uint8_t kUnderWay = 2, kDone = 5;
+
+const MissionName* find(uint32_t key) {
+    const auto it = std::lower_bound(std::begin(kNames), std::end(kNames), key,
+                                     [](const MissionName& m, uint32_t k) { return m.key < k; });
+    return it != std::end(kNames) && it->key == key ? it : nullptr;
+}
+
+std::mutex g_mutex;
+std::unordered_map<uint32_t, uint8_t> g_state;  // our missions' last state
+std::deque<uint32_t> g_out;                     // our completions to tell the other player
+std::deque<uint32_t> g_in;                      // theirs, to show
+
+uint32_t g_test_key = 0;
+uint64_t g_connected_at = 0;
+
+bool plausible_state(uint8_t s) { return s == 0 || s == 1 || s == kUnderWay || s == kDone || s == 0xFF; }
+
+}  // namespace
+
+void party_quests_set_test(uint32_t key) { g_test_key = key; }
+
+std::string party_quests_name(uint32_t key) {
+    const MissionName* m = find(key);
+    return m ? m->name : "";
+}
+
+void party_quests_observe_s2c(const uint8_t* packet, size_t size) {
+    if (size < 5 + 12) return;
+    uint16_t op;
+    std::memcpy(&op, packet, 2);
+    if (op != kOpUpdateMissionListAck) return;
+    const uint8_t* p = packet + 5;
+    const size_t n = size - 5;
+    // The records differ in length (25 to 55 bytes), so walk the keys: every u32 that is a named mission with a
+    // plausible state after it. A key seen for the first time only sets its baseline (the login lists every mission).
+    std::lock_guard lock(g_mutex);
+    for (size_t i = 5; i + 6 <= n; ++i) {
+        uint32_t key;
+        std::memcpy(&key, p + i, 4);
+        const MissionName* m = find(key);
+        if (!m || m->kind == 'O' || !plausible_state(p[i + 4]) || !plausible_state(p[i + 5])) continue;
+        const uint8_t s = p[i + 4];
+        auto [it, fresh] = g_state.try_emplace(key, s);
+        if (!fresh && it->second != s) {
+            if (s == kDone && it->second == kUnderWay && g_out.size() < 16) {
+                g_out.push_back(key);
+                log::info("Party journal: we completed {} \"{}\"", key, m->name);
+            }
+            it->second = s;
+        }
+        i += 5;
+    }
+}
+
+void party_quests_on_event(const uint8_t* d, size_t n) {
+    if (n < 4) return;
+    uint32_t key;
+    std::memcpy(&key, d, 4);
+    std::lock_guard lock(g_mutex);
+    if (find(key) && g_in.size() < 16) g_in.push_back(key);
+}
+
+std::string party_quests_tick(bool connected, const std::string& who) {
+    std::vector<uint32_t> out;
+    uint32_t in = 0;
+    bool ours_too = false, ours_done = false;
+    {
+        std::lock_guard lock(g_mutex);
+        if (!connected) {
+            g_out.clear();
+            g_in.clear();
+            g_connected_at = 0;
+            return {};
+        }
+        const uint64_t now = GetTickCount64();
+        if (!g_connected_at) g_connected_at = now;
+        if (g_test_key && now - g_connected_at > 60000) {
+            log::info("Party journal: [dev] quest_test: we completed {}", g_test_key);
+            g_out.push_back(g_test_key);
+            g_test_key = 0;
+        }
+        out.assign(g_out.begin(), g_out.end());
+        g_out.clear();
+        if (!g_in.empty()) {
+            in = g_in.front();
+            g_in.pop_front();
+            const auto s = g_state.find(in);
+            ours_too = s != g_state.end() && s->second == kUnderWay;
+            ours_done = s != g_state.end() && s->second == kDone;
+        }
+    }
+    for (uint32_t key : out) {
+        std::vector<uint8_t> b(4);
+        std::memcpy(b.data(), &key, 4);
+        activity_send(kQuestType, b);
+    }
+    if (!in) return {};
+    const MissionName* m = find(in);
+    if (!m) return {};
+    log::info("Party journal: {} completed {} \"{}\"{}", who, in, m->name, ours_too ? " (ours too)" : "");
+    const std::string title = m->kind == 'C' ? std::format("{}: Challenge Complete", who)
+                                             : std::format("{}: Quest Updated", who);
+    std::string body = m->name;
+    if (ours_too) body += "   (you are on this quest too: finish it together)";
+    else if (ours_done) body += "   (you have done this one)";
+    return title + "\n" + body;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/party_quests.h b/upstream/cd-coop-3446/src/mod/net/party_quests.h
new file mode 100644
index 0000000..cc8ad72
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/party_quests.h
@@ -0,0 +1,37 @@
+#pragma once
+// Co-op+ party journal (user 2026-11-02: "party based shared progression ... quests, missions, story shared across the
+// party"). D42.
+//
+// What the game allows: each player's quests live in their own in-process server, which advances them from that
+// player's own world (dialogs, triggers, native kills) and ignores progress requests from outside (the quest and
+// knowledge cheat requests get no answer on retail, LOG 2026-11-02). So a quest cannot be completed in the guest's
+// save by the host's actions. What is shared instead: the journal. Our server lists our missions in
+// UpdateMissionListAck (S>C 2360): records of u32 mission key | u8 state (2 under way, 5 done) | u8 kind | ...; when
+// one of ours turns done, the other player is told (Activity type 13: u32 key), and they get the game's
+// "quest complete" notice with its name (mission_names.inc, from the game data), marked when they have the same
+// quest under way: walking the same objective together (same place, same dialog) finishes it in both worlds.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace cdmp::net {
+
+// Our server's messages: our mission states.
+void party_quests_observe_s2c(const uint8_t* packet, size_t size);
+
+// Activity type 13 from the other player (payload after the Activity header).
+void party_quests_on_event(const uint8_t* data, size_t n);
+
+// Once per network loop: our completions to send (through activity_send), and the next notice to show ("" = none),
+// "title\nbody" (the overlay's notice format). `who`: the other player's name.
+std::string party_quests_tick(bool connected, const std::string& who);
+
+// [dev] quest_test: one-PC test with the echo peer: 60 s after connecting, act as if we completed this mission (its
+// echo then shows as the other player's).
+void party_quests_set_test(uint32_t key);
+
+// The game's name of a mission ("" when unknown).
+std::string party_quests_name(uint32_t key);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/party_scaling.cpp b/upstream/cd-coop-3446/src/mod/net/party_scaling.cpp
new file mode 100644
index 0000000..5e89a72
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/party_scaling.cpp
@@ -0,0 +1,155 @@
+#include "mod/net/party_scaling.h"
+
+#include <atomic>
+#include <cstring>
+#include <deque>
+#include <format>
+#include <mutex>
+#include <vector>
+
+#include "common/clock.h"
+#include "mod/log.h"
+#include "mod/net/boss_safe.h"
+#include "mod/net/enemy_relay.h"
+#include "mod/net/troc_sniffer.h"
+
+namespace cdmp::net {
+namespace {
+
+// Co-op+: message numbers for game 1.0.0.3460, read from the live Troc table (every
+// TrocTr handler instance: RTTI name, opcode). The values here before were 2976-era.
+constexpr uint16_t kOpVaryStatCheatReq = 2326;  // u32 key | u32 stat | u8 mode | i32 delta | u8 | u8
+constexpr uint32_t kStatHP = 0x000F4240;
+constexpr size_t kMaxPending = 64;
+
+struct GiveBack {
+    uint32_t enemy;
+    int32_t hp;
+};
+
+std::mutex g_mutex;
+scaling::Settings g_settings;
+scaling::InjectedLedger g_ledger;
+std::deque<GiveBack> g_pending;
+std::atomic<bool> g_enabled{false};  // fast path for the sniffer thread
+std::atomic<int> g_players{1};
+std::atomic<bool> g_host{false};
+uint64_t g_given = 0, g_given_hp = 0, g_skipped_ours = 0, g_dropped = 0, g_failed = 0;
+
+float multiplier_locked(bool boss = false) {
+    return g_host.load() ? scaling::health_multiplier(scaling::for_boss(g_settings, boss), g_players.load()) : 1.0f;
+}
+
+std::vector<uint8_t> cheat_packet(uint32_t enemy, int32_t delta) {
+    uint8_t b[15] = {};
+    std::memcpy(b, &enemy, 4);
+    std::memcpy(b + 4, &kStatHP, 4);
+    // b[8] mode 0: the change is attributed to our player, as guest_hits does.
+    std::memcpy(b + 9, &delta, 4);
+    std::vector<uint8_t> p(5 + sizeof b);
+    const uint16_t op = kOpVaryStatCheatReq, len = sizeof b;
+    std::memcpy(p.data(), &op, 2);
+    p[2] = 0;
+    std::memcpy(p.data() + 3, &len, 2);
+    std::memcpy(p.data() + 5, b, sizeof b);
+    return p;
+}
+
+}  // namespace
+
+void scaling_configure(const scaling::Settings& s) {
+    std::lock_guard lock(g_mutex);
+    g_settings = s;
+    g_enabled = s.enabled;
+    log::info("Scaling: enemy toughness with a guest {} (health x{:.2f}, bosses x{:.2f})",
+              s.enabled ? "ON" : "off", scaling::health_multiplier(s, 2),
+              scaling::health_multiplier(scaling::for_boss(s, true), 2));
+}
+
+void scaling_set_party(int players, bool host) {
+    const int before = g_players.exchange(players);
+    const bool was_host = g_host.exchange(host);
+    if (before != players || was_host != host) {
+        std::lock_guard lock(g_mutex);
+        const float k = multiplier_locked();
+        if (g_settings.enabled) {
+            log::info("Scaling: {} player(s), {} -> enemies take 1/{:.2f} of their damage", players,
+                      host ? "host" : "guest (the host scales)", k);
+        }
+        if (k <= 1.0f) g_pending.clear();
+    }
+}
+
+float scaling_multiplier(bool boss) {
+    std::lock_guard lock(g_mutex);
+    return multiplier_locked(boss);
+}
+
+int32_t scaling_guest_damage(uint32_t enemy, int32_t damage) {
+    return scaling::scale_damage(damage, scaling_multiplier(boss_is_boss(enemy)));
+}
+
+void scaling_note_injected(uint32_t enemy, int32_t loss_hp) {
+    // Whenever scaling could apply at all: the regular and boss multipliers differ, so
+    // "regular is x1" must not keep a boss's guest blow out of the ledger.
+    if (!g_enabled || !g_host || g_players < 2) return;
+    std::lock_guard lock(g_mutex);
+    g_ledger.note(enemy, loss_hp, now_ms());
+}
+
+void scaling_observe_hp(uint32_t enemy, int64_t before_x1000, int64_t after_x1000, bool by_us) {
+    if (!by_us || before_x1000 <= after_x1000 || !g_enabled || !g_host || g_players < 2) return;
+    const bool boss = boss_is_boss(enemy);  // boss_safe's own lock, never ours
+    std::lock_guard lock(g_mutex);
+    const float k = multiplier_locked(boss);
+    if (k <= 1.0f) return;
+    if (g_ledger.consume(enemy, before_x1000 - after_x1000, now_ms())) {
+        ++g_skipped_ours;  // the guest's blow, already scaled
+        return;
+    }
+    const int32_t back = scaling::heal_back(before_x1000, after_x1000, k);
+    if (back <= 0) return;
+    if (g_pending.size() >= kMaxPending) {
+        ++g_dropped;
+        return;
+    }
+    g_pending.push_back({enemy, back});
+}
+
+void scaling_tick() {
+    std::deque<GiveBack> due;
+    {
+        std::lock_guard lock(g_mutex);
+        if (g_pending.empty()) return;
+        due.swap(g_pending);
+    }
+    for (const auto& g : due) {
+        // Only hostile enemies that are fighting: never the animals, civilians or
+        // guards the host happens to hit. Checked here, on the network thread, so the
+        // sniffer thread never waits on the relay's locks.
+        if (!enemy_hostile_in_combat(g.enemy)) continue;
+        const bool ok = sniffer_inject_c2s(cheat_packet(g.enemy, g.hp));
+        std::lock_guard lock(g_mutex);
+        if (!ok) {
+            ++g_failed;
+            continue;
+        }
+        if (g_given++ < 20) log::info("Scaling: gave enemy 0x{:08X} back {} HP", g.enemy, g.hp);
+        g_given_hp += static_cast<uint64_t>(g.hp);
+    }
+}
+
+std::string scaling_hud_text() {
+    std::lock_guard lock(g_mutex);
+    const float k = multiplier_locked();
+    if (k <= 1.0f) return {};
+    return std::format("Enemies: health x{:.1f} ({} players)", k, g_players.load());
+}
+
+std::string scaling_describe() {
+    std::lock_guard lock(g_mutex);
+    return std::format("Scaling: x{:.2f} | gave back {} times, {} HP | guest blows skipped {} | dropped {} failed {}",
+                       multiplier_locked(), g_given, g_given_hp, g_skipped_ours, g_dropped, g_failed);
+}
+
+}  // namespace cdmp::net
