diff --git a/upstream/cd-coop-3446/src/mod/net/save_guard.cpp b/upstream/cd-coop-3446/src/mod/net/save_guard.cpp
new file mode 100644
index 0000000..8575646
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/save_guard.cpp
@@ -0,0 +1,186 @@
+#include "mod/net/save_guard.h"
+
+#include <windows.h>
+#include <shlobj.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <filesystem>
+#include <format>
+#include <mutex>
+#include <system_error>
+#include <vector>
+
+#include "common/clock.h"
+#include "mod/log.h"
+#include "mod/net/troc_sniffer.h"
+
+#pragma comment(lib, "shell32.lib")
+#pragma comment(lib, "ole32.lib")
+
+namespace cdmp::net {
+namespace {
+
+namespace fs = std::filesystem;
+
+// Fallbacks from the 2976 message table (docs/research/data/troc_messages_2976.csv);
+// resolved by name at runtime (opcode_for), so a patch that renumbers them is fine.
+// Co-op+: message numbers for game 1.0.0.3460, read from the live Troc table (every
+// TrocTr handler instance: RTTI name, opcode). The values here before were 2976-era.
+constexpr uint16_t kOpSaveAutoReq = 3134;
+constexpr uint16_t kOpSaveToFileCurrentPlayerReq = 2122;
+// Co-op+: the server's answer to EVERY save, including the autosaves it starts itself on entering some areas
+// (no request before it, 2026-11-02): u32 player | u32 slot | ... (slot 2 = the autosave slot).
+constexpr uint16_t kOpSaveToFileCurrentPlayerAck = 2966;
+constexpr uint64_t kBackupEveryMs = 10 * 60 * 1000;
+constexpr size_t kKeepBackups = 10;
+constexpr uint64_t kNoticeMs = 20000;
+
+std::atomic<bool> g_enabled{true};
+std::atomic<bool> g_connected{false};
+std::atomic<uint64_t> g_saves_in_coop{0};
+std::atomic<uint64_t> g_last_save_ms{0};
+std::mutex g_mutex;
+std::string g_peer;
+std::string g_last_backup;  // folder name of the newest backup
+uint64_t g_last_backup_ms = 0;
+
+// Paths in the log as UTF-8 (a user name may hold characters the ANSI code page lacks).
+std::string utf8(const fs::path& p) {
+    const auto u = p.u8string();
+    return std::string(u.begin(), u.end());
+}
+
+// The save opcodes, by name once the sniffer has read the game's message table.
+std::atomic<uint32_t> g_ops{0};  // auto | file << 16, 0 = not resolved yet
+void save_ops(uint16_t& auto_op, uint16_t& file_op) {
+    uint32_t v = g_ops.load();
+    if (!v) {
+        auto_op = opcode_for("SaveAutoReq", kOpSaveAutoReq);
+        file_op = opcode_for("SaveToFileCurrentPlayerReq", kOpSaveToFileCurrentPlayerReq);
+        if (opcodes_resolved()) g_ops = static_cast<uint32_t>(auto_op) | (static_cast<uint32_t>(file_op) << 16);
+        return;
+    }
+    auto_op = static_cast<uint16_t>(v & 0xFFFF);
+    file_op = static_cast<uint16_t>(v >> 16);
+}
+
+fs::path known_folder(REFKNOWNFOLDERID id) {
+    PWSTR p = nullptr;
+    fs::path out;
+    if (SUCCEEDED(SHGetKnownFolderPath(id, 0, nullptr, &p)) && p) out = p;
+    CoTaskMemFree(p);
+    return out;
+}
+
+// Copies the save folder; returns the backup's folder name ("" on failure).
+std::string backup_saves() {
+    const fs::path local = known_folder(FOLDERID_LocalAppData);
+    const fs::path docs = known_folder(FOLDERID_Documents);
+    if (local.empty() || docs.empty()) return {};
+    const fs::path src = local / L"Pearl Abyss" / L"CD" / L"save";
+    std::error_code ec;
+    if (!fs::exists(src, ec)) {
+        log::warn("Save guard: no save folder at {}; nothing to back up", utf8(src));
+        return {};
+    }
+    SYSTEMTIME t;
+    GetLocalTime(&t);
+    const std::string name = std::format("auto-{:04}-{:02}-{:02}_{:02}-{:02}-{:02}-before-coop", t.wYear, t.wMonth,
+                                         t.wDay, t.wHour, t.wMinute, t.wSecond);
+    const fs::path root = docs / L"CrimsonDesert-CoopPlus-SaveBackups";
+    const fs::path dst = root / name;
+    fs::create_directories(dst, ec);
+    if (ec) {
+        log::warn("Save guard: cannot create {}: {}", utf8(dst), ec.message());
+        return {};
+    }
+    fs::copy(src, dst, fs::copy_options::recursive | fs::copy_options::overwrite_existing, ec);
+    if (ec) {
+        log::warn("Save guard: backup to {} failed: {}", utf8(dst), ec.message());
+        return {};
+    }
+    // Keep the newest automatic backups only; the installer's own backups are not touched.
+    std::vector<fs::path> autos;
+    for (const auto& e : fs::directory_iterator(root, ec)) {
+        if (e.is_directory(ec) && e.path().filename().string().rfind("auto-", 0) == 0) autos.push_back(e.path());
+    }
+    std::sort(autos.begin(), autos.end());  // names start with the date: oldest first
+    while (autos.size() > kKeepBackups) {
+        fs::remove_all(autos.front(), ec);
+        autos.erase(autos.begin());
+    }
+    log::info("Save guard: saves backed up to {}", utf8(dst));
+    return name;
+}
+
+}  // namespace
+
+void save_guard_configure(bool enabled) {
+    g_enabled = enabled;
+    log::info("Save guard: {}", enabled ? "on (backup when a co-op session starts, warning on saves during co-op)"
+                                        : "off");
+}
+
+void save_guard_set_connected(bool connected, const std::string& peer_name) {
+    const bool was = g_connected.exchange(connected);
+    if (!connected || was || !g_enabled) return;
+    {
+        std::lock_guard lock(g_mutex);
+        g_peer = peer_name;
+        if (g_last_backup_ms && now_ms() - g_last_backup_ms < kBackupEveryMs) return;
+    }
+    // A few MB of files: fine on the mod's network thread, never the game's.
+    const std::string name = backup_saves();
+    std::lock_guard lock(g_mutex);
+    if (!name.empty()) {
+        g_last_backup = name;
+        g_last_backup_ms = now_ms();
+    }
+}
+
+void save_guard_observe_c2s(const uint8_t* packet, size_t size) {
+    if (!g_enabled || !g_connected || size < 5) return;
+    uint16_t op = 0;
+    std::memcpy(&op, packet, 2);
+    uint16_t auto_op = 0, file_op = 0;
+    save_ops(auto_op, file_op);
+    if (op != auto_op && op != file_op) return;
+    const uint64_t n = ++g_saves_in_coop;
+    g_last_save_ms = now_ms() ? now_ms() : 1;
+    std::lock_guard lock(g_mutex);
+    log::warn("Save guard: the game saved ({}) while '{}' is in the session [{} so far]; if this save misbehaves, "
+              "restore Documents\\CrimsonDesert-CoopPlus-SaveBackups\\{}",
+              op == auto_op ? "autosave" : "manual save", g_peer, n,
+              g_last_backup.empty() ? "(no backup this session)" : g_last_backup);
+}
+
+void save_guard_observe_s2c(const uint8_t* packet, size_t size) {
+    if (!g_enabled || size < 5 + 8) return;
+    uint16_t op = 0;
+    std::memcpy(&op, packet, 2);
+    if (op != kOpSaveToFileCurrentPlayerAck) return;
+    uint32_t slot = 0;
+    std::memcpy(&slot, packet + 5 + 4, 4);
+    if (!g_connected) {
+        log::info("Save guard: the game saved into slot {}", slot);
+        return;
+    }
+    const uint64_t n = ++g_saves_in_coop;
+    g_last_save_ms = now_ms() ? now_ms() : 1;
+    std::lock_guard lock(g_mutex);
+    log::warn("Save guard: the game saved into slot {} while '{}' is in the session [{} so far]; if this save "
+              "misbehaves, restore Documents\\CrimsonDesert-CoopPlus-SaveBackups\\{}",
+              slot, g_peer, n, g_last_backup.empty() ? "(no backup this session)" : g_last_backup);
+}
+
+std::string save_guard_hud_text() {
+    const uint64_t at = g_last_save_ms.load();
+    if (!at || now_ms() - at > kNoticeMs) return {};
+    std::lock_guard lock(g_mutex);
+    return g_last_backup.empty() ? "The game saved during co-op (no backup yet)"
+                                 : "The game saved during co-op. Backup: " + g_last_backup;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/save_guard.h b/upstream/cd-coop-3446/src/mod/net/save_guard.h
new file mode 100644
index 0000000..2a78d61
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/save_guard.h
@@ -0,0 +1,36 @@
+#pragma once
+// Save safety for co-op (Co-op+, brief 6.3: "always back up saves").
+//
+// Upstream's rule is "do not save while the other player is in your world": the
+// other player's character is an actor our own server did not create, and a save
+// taken then may reference it. Players forget, and the game autosaves on its own.
+// The sniffer only observes, so saves cannot (and should not) be blocked. Instead:
+//   - when a co-op session connects, the save folder is copied to
+//     Documents\CrimsonDesert-CoopPlus-SaveBackups\auto-<date>-<time> (at most
+//     every 10 minutes, the newest 10 kept), so there is always a copy from
+//     before the other player arrived;
+//   - a save request (SaveAutoReq / SaveToFileCurrentPlayerReq) seen while the
+//     other player is connected is logged and shown on the panel, naming the
+//     backup to restore if the save turns out damaged.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace cdmp::net {
+
+void save_guard_configure(bool enabled);
+
+// Network thread: the co-op session is (still) connected or not. A new
+// connection triggers the backup.
+void save_guard_set_connected(bool connected, const std::string& peer_name);
+
+// Sniffer thread (capture_observe_c2s).
+void save_guard_observe_c2s(const uint8_t* packet, size_t size);
+// Sniffer thread (capture_observe_s2c): the server confirms every save, autosaves included.
+void save_guard_observe_s2c(const uint8_t* packet, size_t size);
+
+// Panel line ("" when nothing to say).
+std::string save_guard_hud_text();
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/stage_cinema.cpp b/upstream/cd-coop-3446/src/mod/net/stage_cinema.cpp
new file mode 100644
index 0000000..5773fd0
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/stage_cinema.cpp
@@ -0,0 +1,331 @@
+#include "mod/net/stage_cinema.h"
+
+#include <windows.h>
+
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <format>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+#include "mod/net/enemy_relay.h"
+#include "mod/net/local_capture.h"
+#include "mod/net/remote_puppet.h"
+#include "mod/net/troc_sniffer.h"
+
+namespace cdmp::net {
+namespace {
+
+// 3479 opcodes (layouts: weather_sync.cpp, NOTES/LOG.md 2026-11-02 17:10).
+constexpr uint16_t kOpPrepareSequencerAck = 2380;
+constexpr uint16_t kOpDeleteSequencerAck = 2292;
+constexpr uint16_t kOpStageBranchStateAck = 2920;
+constexpr uint16_t kOpStageOnBranchEventAck = 2436;
+constexpr uint16_t kOpUpdateStageChartEventReq = 2839;
+constexpr uint16_t kOpUpdateStageChartEventAck = 2187;
+constexpr uint16_t kOpSetAvoidByCutSceneAck = 2708;  // u8 4 | u32 player | u64 stage | u8 on | u32 player
+constexpr uint64_t kFakeIdBase = 0x7D000000;
+constexpr float kNearM = 100.0f;          // the user's cutscene range
+constexpr uint32_t kMaxMs = 180000;       // a copy never outlives this
+constexpr uint32_t kPickWindowMs = 5000;  // the stage named / changed this long before the cutscene started
+constexpr uint32_t kTestDelayMs = 3000;
+constexpr size_t kPrepKeyAt = 19, kPrepIdAt = 9, kPrepMin = 23, kBindingsFrom = 86;
+enum : uint8_t { kStart = 7, kEnd = 8, kBranch = 9 };
+
+using Bytes = std::vector<uint8_t>;
+
+std::atomic<bool> g_enabled{true};
+std::atomic<bool> g_test{false};
+
+struct Stage {
+    Bytes prepare, branch, on_branch;  // payloads, as our server sent them
+    uint32_t changed_ms = 0;           // GetTickCount of the last branch message
+};
+
+std::mutex g_mutex;
+// Host side (our server's stages).
+std::map<uint64_t, Stage> g_stages;
+uint64_t g_avoid_id = 0;
+uint32_t g_avoid_ms = 0;
+uint64_t g_relayed = 0;           // the stage we told the other player about (0 = none)
+uint32_t g_relayed_changed = 0;
+bool g_last_cut = false;
+uint32_t g_cut_since = 0;
+bool g_test_started = false;
+// Guest side.
+struct Copy {
+    bool pending = false, active = false;
+    Bytes prepare, branch, on_branch;
+    std::array<float, 3> where{};
+    uint64_t id = 0;
+    uint32_t key = 0, since = 0;
+    uint32_t active_key = 0;  // the stage of the copy running now (key may already name the next one)
+} g_copy;
+uint64_t g_next_fake = kFakeIdBase;
+
+template <class T>
+T rd(const uint8_t* p) {
+    T v;
+    std::memcpy(&v, p, sizeof v);
+    return v;
+}
+
+uint32_t ticks() { return static_cast<uint32_t>(GetTickCount64()); }
+
+void put_blob(Bytes& out, const Bytes& b) {
+    const auto n = static_cast<uint16_t>(b.size());
+    out.insert(out.end(), reinterpret_cast<const uint8_t*>(&n), reinterpret_cast<const uint8_t*>(&n) + 2);
+    out.insert(out.end(), b.begin(), b.end());
+}
+
+bool get_blob(const uint8_t*& p, const uint8_t* end, Bytes& b) {
+    if (end - p < 2) return false;
+    const uint16_t n = rd<uint16_t>(p);
+    p += 2;
+    if (end - p < n) return false;
+    b.assign(p, p + n);
+    p += n;
+    return true;
+}
+
+// The stage's world actors (node bindings after the fixed part) as the other player's copies of them.
+Bytes for_guest(Bytes prepare) {
+    for (size_t i = kBindingsFrom; i + 4 <= prepare.size(); ++i) {
+        const uint32_t k = rd<uint32_t>(prepare.data() + i);
+        if ((k & 0xFFF00000u) != 0xB0100000u) continue;
+        if (const uint32_t copy = enemy_copy_of(k)) {
+            std::memcpy(prepare.data() + i, &copy, 4);
+            i += 3;
+        }
+    }
+    return prepare;
+}
+
+// A payload of ours with the other player's key and the server's sequencer id replaced (ours / our copy's id).
+Bytes as_ours(Bytes p, uint32_t player, uint64_t id, size_t id_at) {
+    if (p.size() < id_at + 8 || p.size() < 5) return p;
+    const uint32_t theirs = rd<uint32_t>(p.data() + 1);
+    for (size_t i = 0; i + 4 <= p.size(); ++i) {
+        if (rd<uint32_t>(p.data() + i) == theirs) std::memcpy(p.data() + i, &player, 4);
+    }
+    std::memcpy(p.data() + id_at, &id, 8);
+    return p;
+}
+
+void send(uint8_t type, const Bytes& data) { activity_send(type, data); }
+
+}  // namespace
+
+uint32_t cinema_stage_key(uint64_t id) {
+    std::lock_guard lock(g_mutex);
+    const auto it = g_stages.find(id);
+    return it == g_stages.end() || it->second.prepare.size() < kPrepMin ? 0
+                                                                         : rd<uint32_t>(it->second.prepare.data() + kPrepKeyAt);
+}
+
+void cinema_set_enabled(bool on) { g_enabled = on; }
+void cinema_set_test(bool on) { g_test = on; }
+
+void cinema_observe_s2c(const uint8_t* packet, size_t size) {
+    if (size < 5 + 13) return;
+    const uint16_t op = rd<uint16_t>(packet);
+    const uint8_t* p = packet + 5;
+    const size_t n = size - 5;
+    if (op != kOpPrepareSequencerAck && op != kOpDeleteSequencerAck && op != kOpStageBranchStateAck &&
+        op != kOpStageOnBranchEventAck && op != kOpSetAvoidByCutSceneAck) {
+        return;
+    }
+    std::lock_guard lock(g_mutex);
+    if (op == kOpPrepareSequencerAck && n >= kPrepMin) {
+        Stage& s = g_stages[rd<uint64_t>(p + kPrepIdAt)];
+        s = Stage{};
+        s.prepare.assign(p, p + n);
+    } else if (op == kOpDeleteSequencerAck && n >= 12) {
+        g_stages.erase(rd<uint64_t>(p + 4));
+    } else if (op == kOpStageBranchStateAck || op == kOpStageOnBranchEventAck) {
+        auto it = g_stages.find(rd<uint64_t>(p + 5));
+        if (it == g_stages.end()) return;
+        (op == kOpStageBranchStateAck ? it->second.branch : it->second.on_branch).assign(p, p + n);
+        it->second.changed_ms = ticks();
+    } else if (op == kOpSetAvoidByCutSceneAck && n >= 14 && p[13]) {
+        g_avoid_id = rd<uint64_t>(p + 5);
+        g_avoid_ms = ticks();
+    }
+}
+
+void cinema_observe_c2s(const uint8_t* packet, size_t size) {
+    if (size < 5 + 17 || rd<uint16_t>(packet) != kOpUpdateStageChartEventReq) return;
+    const uint8_t* p = packet + 5;
+    const uint64_t id = rd<uint64_t>(p);
+    if (id < kFakeIdBase || id >= kFakeIdBase + 0x1000000) return;
+    const uint32_t player = capture_own_player_key();
+    if (!player) return;
+    Bytes a(13);
+    a[0] = 4;
+    std::memcpy(a.data() + 1, &player, 4);
+    std::memcpy(a.data() + 5, &id, 8);
+    a.insert(a.end(), p + 8, p + 17);
+    puppet_inject_s2c_batch({{kOpUpdateStageChartEventAck, std::move(a)}});
+}
+
+void cinema_on_event(uint8_t type, const uint8_t* d, size_t size) {
+    const uint8_t* end = d + size;
+    std::lock_guard lock(g_mutex);
+    if (type == kStart && size >= 4 + 12) {
+        Copy c;
+        c.key = rd<uint32_t>(d);
+        std::memcpy(c.where.data(), d + 4, 12);
+        const uint8_t* p = d + 16;
+        if (!get_blob(p, end, c.prepare) || !get_blob(p, end, c.branch) || !get_blob(p, end, c.on_branch)) return;
+        if (c.prepare.size() < kPrepMin) return;
+        c.pending = true;
+        c.since = ticks();
+        c.active = g_copy.active;  // a copy still running ends first
+        c.id = g_copy.id;
+        c.active_key = g_copy.active_key;
+        g_copy = std::move(c);
+        log::info("Cinema: the other player's cutscene is in stage {}", g_copy.key);
+    } else if (type == kBranch && g_copy.active) {
+        const uint8_t* p = d;
+        Bytes b, ob;
+        if (!get_blob(p, end, b) || !get_blob(p, end, ob)) return;
+        const uint32_t player = capture_own_player_key();
+        std::vector<std::pair<uint16_t, Bytes>> inject;
+        if (!b.empty()) inject.push_back({kOpStageBranchStateAck, as_ours(b, player, g_copy.id, 5)});
+        if (!ob.empty()) inject.push_back({kOpStageOnBranchEventAck, as_ours(ob, player, g_copy.id, 5)});
+        puppet_inject_s2c_batch(inject);
+    } else if (type == kEnd) {
+        g_copy.pending = false;
+        g_copy.since = 0;  // the tick ends an active copy
+    }
+}
+
+void cinema_tick(bool connected, bool host, bool cut, std::optional<std::array<float, 3>> me,
+                 std::optional<std::array<float, 3>> partner, uint32_t now) {
+    if (!g_enabled) return;
+    const uint32_t t = ticks();
+    const bool loading = sniffer_world_loading();
+    const uint32_t player = capture_own_player_key();
+    std::vector<std::pair<uint16_t, Bytes>> inject;
+    std::vector<std::pair<uint8_t, Bytes>> out;
+    std::string note;
+    {
+        std::lock_guard lock(g_mutex);
+        // ---- our cutscene: which stage, and tell the other player
+        if (cut != g_last_cut) {
+            g_last_cut = cut;
+            g_cut_since = t;
+            g_test_started = false;
+            if (cut && !loading) {
+                uint64_t pick = 0;
+                if (g_avoid_id && t - g_avoid_ms < kPickWindowMs && g_stages.count(g_avoid_id)) {
+                    pick = g_avoid_id;
+                } else {
+                    uint32_t best = kPickWindowMs;
+                    for (const auto& [id, s] : g_stages) {
+                        if (s.changed_ms && t - s.changed_ms < best) best = t - s.changed_ms, pick = id;
+                    }
+                }
+                g_relayed = pick;
+                if (pick) {
+                    const Stage& s = g_stages[pick];
+                    g_relayed_changed = s.changed_ms;
+                    const uint32_t key = rd<uint32_t>(s.prepare.data() + kPrepKeyAt);
+                    note = "Cinema: our cutscene is in stage " + std::to_string(key) + " (sequencer 0x" +
+                           std::format("{:X}", pick) + ")";
+                    if (connected) {
+                        Bytes b(16);
+                        std::memcpy(b.data(), &key, 4);
+                        const std::array<float, 3> here = me.value_or(std::array<float, 3>{});
+                        std::memcpy(b.data() + 4, here.data(), 12);
+                        put_blob(b, for_guest(s.prepare));
+                        put_blob(b, s.branch);
+                        put_blob(b, s.on_branch);
+                        if (b.size() <= 1000) out.push_back({kStart, std::move(b)});
+                        else note += "; too big to send";
+                    }
+                } else {
+                    note = "Cinema: our cutscene is not in a stage we know (not shared)";
+                }
+            } else if (!cut && g_relayed) {
+                if (connected) out.push_back({kEnd, {}});
+                g_relayed = 0;
+            }
+        } else if (cut && g_relayed && connected) {
+            // Branch changes of the stage while its cutscene plays.
+            const auto it = g_stages.find(g_relayed);
+            if (it != g_stages.end() && it->second.changed_ms != g_relayed_changed) {
+                g_relayed_changed = it->second.changed_ms;
+                Bytes b;
+                put_blob(b, it->second.branch);
+                put_blob(b, it->second.on_branch);
+                out.push_back({kBranch, std::move(b)});
+            }
+        }
+        // [dev] cinema_test: our own stage as if the host sent it, kTestDelayMs into the cutscene.
+        if (g_test && cut && g_relayed && !g_test_started && t - g_cut_since > kTestDelayMs) {
+            g_test_started = true;
+            const Stage& s = g_stages[g_relayed];
+            Copy c;
+            c.key = rd<uint32_t>(s.prepare.data() + kPrepKeyAt);
+            c.where = me.value_or(std::array<float, 3>{});
+            c.prepare = s.prepare;
+            c.branch = s.branch;
+            c.on_branch = s.on_branch;
+            c.pending = true;
+            c.since = t;
+            c.active = g_copy.active;
+            c.id = g_copy.id;
+            c.active_key = g_copy.active_key;
+            g_copy = std::move(c);
+            note = "Cinema: [dev] cinema_test: starting a copy of our own stage " + std::to_string(g_copy.key);
+        }
+        if (g_test && !cut && g_copy.active && t - g_cut_since > 1000) g_copy.since = 0;  // test: ends with ours
+
+        // ---- guest: run the copy
+        Copy& c = g_copy;
+        const bool linked = connected || g_test;
+        const bool expired = c.since == 0 || t - c.since > kMaxMs || !linked || loading;
+        if (c.active && (expired || c.pending)) {  // ended, or replaced by a new one
+            if (player) inject.push_back({kOpDeleteSequencerAck, [&] {
+                Bytes d(17, 0);
+                std::memcpy(d.data(), &player, 4);
+                std::memcpy(d.data() + 4, &c.id, 8);
+                std::memcpy(d.data() + 12, &c.active_key, 4);
+                d[16] = 7;
+                return d;
+            }()});
+            c.active = false;
+            note = "Cinema: the copy of stage " + std::to_string(c.active_key) + " ended";
+        }
+        if (c.pending && !expired && player && (!host || g_test) && (g_test || !cut)) {
+            const std::array<float, 3> here = me.value_or(c.where);
+            const bool in_range = std::hypot(here[0] - c.where[0], here[2] - c.where[2]) <= kNearM;
+            (void)partner;
+            if (in_range) {
+                c.pending = false;
+                c.active = true;
+                c.id = g_next_fake++;
+                c.active_key = c.key;
+                inject.push_back({kOpPrepareSequencerAck, as_ours(c.prepare, player, c.id, kPrepIdAt)});
+                if (!c.branch.empty()) inject.push_back({kOpStageBranchStateAck, as_ours(c.branch, player, c.id, 5)});
+                if (!c.on_branch.empty()) {
+                    inject.push_back({kOpStageOnBranchEventAck, as_ours(c.on_branch, player, c.id, 5)});
+                }
+                note = std::format("Cinema: playing the other player's cutscene (stage {} as 0x{:X}, {} bytes)", c.key,
+                                   c.id, c.prepare.size());
+            }
+        }
+    }
+    for (auto& [type, b] : out) send(type, b);
+    if (!inject.empty()) puppet_inject_s2c_batch(inject);
+    if (!note.empty()) log::info("{}", note);
+    (void)now;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/stage_cinema.h b/upstream/cd-coop-3446/src/mod/net/stage_cinema.h
new file mode 100644
index 0000000..ae7eba6
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/stage_cinema.h
@@ -0,0 +1,51 @@
+#pragma once
+// Co-op+: the host's stage cinematics play for the guest too (user 2026-11-02: "you HAVE to be able to play boss
+// fights together (hence needing boss fight cutscenes to play for you)"). D38.
+//
+// A boss fight, a story scene, a minigame intro: each is a STAGE (a .pastage graph + a .paseq timeline) that the
+// player's own client runs; the server starts it (PrepareSequencerAck: the stage key and the world actors bound to its
+// nodes) and moves it between branches (StageBranchStateAck / StageOnBranchEventAck); the cinematic is a branch of
+// it, played by the client. The guest's world does not run the host's boss stage (its boss only exists in the host's
+// world; the guest's own is hidden near the host), so the guest's client never plays the cinematic.
+//
+// So, when the host's cutscene starts inside a stage (SetAvoidByCutSceneAck names the stage, or the stage that changed
+// branch just before), the host sends that stage's PrepareSequencerAck payload (the actors it binds translated to the
+// guest's copies of them, enemy_copy_of) with its current branch messages; branch changes follow while the cutscene
+// plays. A guest within 100 m starts a copy of the stage in its client under a sequencer id of its own (kFakeIdBase +
+// n, its server never hears of it), at the host's branch, answers the client's chart requests for it as the server
+// would (weather_sync does the same), and ends the copy when the host's cutscene ends (or after kMaxMs). The skip
+// rule of coop_activity (everyone must press Esc) then covers both cutscenes.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace cdmp::net {
+
+// Game network thread (troc_sniffer's OnRecvPacket hook), real server packets: records stages and their branches.
+// Never drops anything.
+void cinema_observe_s2c(const uint8_t* packet, size_t size);
+
+// Sniffer thread (capture_observe_c2s): chart requests of our client for a stage copy we started.
+void cinema_observe_c2s(const uint8_t* packet, size_t size);
+
+// coop_activity: the other player's cinema events (Activity types 7 start, 8 end, 9 branch).
+void cinema_on_event(uint8_t type, const uint8_t* data, size_t size);
+
+// coop_activity's tick (every frame). `cut`: our cutscene flag.
+void cinema_tick(bool connected, bool host, bool cut, std::optional<std::array<float, 3>> me,
+                 std::optional<std::array<float, 3>> partner, uint32_t now_ms);
+
+// The stage key of one of our server's running stages (0 = unknown), e.g. the minigame a match is in.
+uint32_t cinema_stage_key(uint64_t sequencer);
+
+// [coop] stage_cinema (default on).
+void cinema_set_enabled(bool on);
+
+// [dev] cinema_test: one-PC test: 3 s into each of our own stage cutscenes, start a copy of that stage as if the
+// host had sent it (shows whether a second copy at the same branch plays, and that ending it cleans up).
+void cinema_set_test(bool on);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/steam_join.cpp b/upstream/cd-coop-3446/src/mod/net/steam_join.cpp
