--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_activity.h
@@ -0,0 +1,64 @@
+#pragma once
+// Co-op+: shared activities (cutscenes and minigames), EventKind::Activity.
+//
+// Cutscenes run inside each player's own client: the server only sees side effects, there is no "start" or "skip"
+// message (captures of the Hernand pub arm wrestling intro, 2026-11-02). We read the game's "cutscene playing" flag
+// (game::cutscene_playing) and tell the other player when ours starts and ends. Skipping needs everyone: while the
+// other player is in a cutscene too, within kNearM of us, a keyboard hook holds back our Esc and only tells them we
+// pressed it; when both have pressed, each mod gives its own game the Esc (D32 as revised by the user 2026-11-02).
+// If the other player is not in a cutscene near us, Esc works as in the game.
+//
+// Minigames: the client asks the server to start one (ActivateMiniGameReq / JoinMiniGameReq), the server spawns the
+// NPC opponent (SpawnMiniGameCharacterReq/Ack), the match itself is simulated in the client, and the end is
+// LeaveMiniGameReq (names the minigame's stage) + MiniGameResultReq. We tell the other player "started" and
+// "finished <game>"; the result bytes did not differ between a win and a loss, so no winner is claimed.
+//
+// Payload: u32 sequence | u8 type | data. Sent three times on the lossy channel; the receiver drops repeats.
+//   type 1 cutscene started | f32 x, y, z     type 2 cutscene ended     type 3 skip pressed | f32 x, y, z
+//   type 4 minigame started | u16 minigame id  type 5 minigame finished | u32 stage key
+//   type 6 versus (10 Hz in a match) | u8 in a match | u32 E presses this match | f32 gauge (the host's)
+// Versus arm wrestling (D35): when both players are in a match (each at their own table), the host owns one gauge
+// that both players' E presses push; each mod writes it into its game (game::minigame_gauge_address), so the one who
+// reaches 100 wins on both screens.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace cdmp::net {
+
+// Client requests we watch (minigame start/end).
+void activity_observe_c2s(const uint8_t* packet, size_t size);
+
+// An Activity event from the other player.
+void activity_on_event(const std::vector<uint8_t>& payload);
+
+struct ActivityTick {
+    std::string banner;  // persistent line while the other player is in a cutscene ("" = none)
+    std::string toast;   // one-off message ("" = none)
+};
+
+// Network loop, every frame: reads our cutscene flag, our Esc key, and applies the other player's skips.
+// `me` / `partner`: positions (partner unset = not connected). `focused`: the game window is in front.
+ActivityTick activity_tick(bool connected, bool host, bool focused, std::optional<std::array<float, 3>> me,
+                           std::optional<std::array<float, 3>> partner, const std::string& partner_name,
+                           uint32_t now_ms);
+
+// [dev] skip_test: one-PC test of the shared skip: during each of our cutscenes act as if the other player were in it
+// too and pressed skip 6 s in (the echo peer cannot press keys).
+void activity_set_skip_test(bool on);
+
+// [dev] versus_test: one-PC test of versus arm wrestling: a simulated other player in every match of ours, pushing
+// this many times a second (0 = off).
+void activity_set_versus_test(int presses_per_s);
+
+// Another Co-op+ module's Activity event (stage_cinema: types 7..9), on the same sequence as ours.
+void activity_send(uint8_t type, const std::vector<uint8_t>& data);
+
+// Human name of a minigame stage key ("arm wrestling"...), "a minigame" when unknown.
+std::string activity_minigame_name(uint32_t stage_key);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_script.cpp b/upstream/cd-coop-3446/src/mod/net/dev_script.cpp
new file mode 100644
index 0000000..f6528b1
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_script.cpp
@@ -0,0 +1,195 @@
+#include "mod/net/dev_script.h"
+
+#include <windows.h>
+
+#include <cctype>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <thread>
+#include <vector>
+
+#include "mod/log.h"
+#include "mod/net/local_capture.h"
+#include "mod/net/remote_puppet.h"
+#include "mod/net/revive_prompt.h"
+#include "mod/net/time_sync.h"
+#include "mod/net/dev_watch.h"
+#include "mod/net/troc_sniffer.h"
+
+namespace cdmp::net {
+namespace {
+
+struct Step {
+    enum Kind { C2S, S2C, Wait, Teleport, Poke, Time, Watch, Day } kind;
+    uintptr_t addr = 0;
+    float to[3] = {};
+    uint16_t op = 0;
+    std::vector<uint8_t> payload;
+    uint32_t wait_ms = 0;
+};
+
+std::string hex_of(const void* p, size_t n) {
+    static const char* d = "0123456789abcdef";
+    std::string s;
+    for (size_t i = 0; i < n; ++i) {
+        const uint8_t b = static_cast<const uint8_t*>(p)[i];
+        s += d[b >> 4];
+        s += d[b & 15];
+    }
+    return s;
+}
+
+void replace_all(std::string& s, const std::string& from, const std::string& to) {
+    for (size_t at = s.find(from); at != std::string::npos; at = s.find(from, at + to.size())) s.replace(at, from.size(), to);
+}
+
+bool parse_hex(const std::string& in, std::vector<uint8_t>& out) {
+    std::string h;
+    for (char c : in)
+        if (std::isxdigit(static_cast<unsigned char>(c))) h += c;
+        else if (!std::isspace(static_cast<unsigned char>(c))) return false;
+    if (h.size() % 2) return false;
+    for (size_t i = 0; i < h.size(); i += 2) out.push_back(static_cast<uint8_t>(std::stoul(h.substr(i, 2), nullptr, 16)));
+    return true;
+}
+
+std::vector<uint8_t> make_c2s(uint16_t op, const std::vector<uint8_t>& payload) {
+    std::vector<uint8_t> pkt(5 + payload.size());
+    const uint16_t len = static_cast<uint16_t>(payload.size());
+    std::memcpy(pkt.data(), &op, 2);
+    pkt[2] = 0;
+    std::memcpy(pkt.data() + 3, &len, 2);
+    if (!payload.empty()) std::memcpy(pkt.data() + 5, payload.data(), payload.size());
+    return pkt;
+}
+
+}  // namespace
+
+int dev_script_run(const std::string& path, uint32_t own_player, float x, float y, float z) {
+    std::ifstream f(path);
+    if (!f) {
+        log::warn("Dev script: cannot read {}", path);
+        return -1;
+    }
+    const uint32_t user = capture_own_user_key();
+    const float pos[3] = {x, y, z};
+    std::vector<Step> steps;
+    std::string line;
+    int lineno = 0;
+    while (std::getline(f, line)) {
+        ++lineno;
+        if (const auto hash = line.find('#'); hash != std::string::npos) line.resize(hash);
+        std::istringstream in(line);
+        std::string kind;
+        if (!(in >> kind)) continue;
+        Step st{};
+        if (kind == "wait") {
+            in >> st.wait_ms;
+            st.kind = Step::Wait;
+            st.wait_ms = std::min<uint32_t>(st.wait_ms, 10000);
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "watch") {
+            std::string a;
+            int len = 4, hits = 8;
+            in >> a >> len >> hits;
+            st.kind = Step::Watch;
+            st.addr = static_cast<uintptr_t>(std::stoull(a, nullptr, 16));
+            st.to[0] = static_cast<float>(len ? len : 4);
+            st.to[1] = static_cast<float>(hits ? hits : 8);
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "day") {
+            st.kind = Step::Day;
+            in >> st.to[0];
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "time") {
+            char colon = 0;
+            if (!(in >> st.to[0] >> colon >> st.to[1]) || colon != ':') {
+                log::warn("Dev script: line {} needs time hh:mm", lineno);
+                continue;
+            }
+            st.kind = Step::Time;
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "poke") {
+            std::string a, rest;
+            in >> a;
+            std::getline(in, rest);
+            st.kind = Step::Poke;
+            st.addr = static_cast<uintptr_t>(std::stoull(a, nullptr, 16));
+            if (!st.addr || !parse_hex(rest, st.payload) || st.payload.empty()) {
+                log::warn("Dev script: line {} needs poke <hex address> <hex bytes>", lineno);
+                continue;
+            }
+            steps.push_back(std::move(st));
+            continue;
+        }
+        if (kind == "tp") {
+            st.kind = Step::Teleport;
+            if (!(in >> st.to[0] >> st.to[1] >> st.to[2])) {
+                log::warn("Dev script: line {} needs tp x y z", lineno);
+                continue;
+            }
+            steps.push_back(st);
+            continue;
+        }
+        unsigned op = 0;
+        if ((kind != "c2s" && kind != "s2c") || !(in >> op)) {
+            log::warn("Dev script: line {} not understood", lineno);
+            continue;
+        }
+        std::string rest;
+        std::getline(in, rest);
+        replace_all(rest, "{P}", hex_of(&own_player, 4));
+        replace_all(rest, "{U}", hex_of(&user, 4));
+        replace_all(rest, "{POS}", hex_of(pos, 12));
+        if (!parse_hex(rest, st.payload)) {
+            log::warn("Dev script: line {} has a bad hex payload", lineno);
+            continue;
+        }
+        st.kind = kind == "c2s" ? Step::C2S : Step::S2C;
+        st.op = static_cast<uint16_t>(op);
+        steps.push_back(std::move(st));
+    }
+    int packets = 0;
+    for (const auto& st : steps) packets += st.kind != Step::Wait;
+    log::info("Dev script: {} packets from {}", packets, path);
+    std::thread([steps = std::move(steps)] {
+        for (const auto& st : steps) {
+            if (st.kind == Step::Wait) {
+                Sleep(st.wait_ms);
+            } else if (st.kind == Step::Watch) {
+                dev_watch_start(st.addr, static_cast<int>(st.to[0]), static_cast<int>(st.to[1]));
+            } else if (st.kind == Step::Day) {
+                time_sync_dev_add_days(static_cast<int>(st.to[0]));
+            } else if (st.kind == Step::Time) {
+                time_sync_dev_set(static_cast<int>(st.to[0]), static_cast<int>(st.to[1]));
+            } else if (st.kind == Step::Poke) {
+                MEMORY_BASIC_INFORMATION mbi{};
+                const bool ok = VirtualQuery(reinterpret_cast<void*>(st.addr), &mbi, sizeof mbi) &&
+                                mbi.State == MEM_COMMIT && (mbi.Protect & (PAGE_READWRITE | PAGE_EXECUTE_READWRITE));
+                if (ok) std::memcpy(reinterpret_cast<void*>(st.addr), st.payload.data(), st.payload.size());
+                log::info("Dev script: poke 0x{:X} ({} bytes){}", st.addr, st.payload.size(), ok ? "" : " REFUSED (not writable)");
+            } else if (st.kind == Step::Teleport) {
+                revive_teleport_to(st.to[0], st.to[1], st.to[2]);
+                log::info("Dev script: teleport to ({:.0f}, {:.0f}, {:.0f})", st.to[0], st.to[1], st.to[2]);
+            } else if (st.kind == Step::C2S) {
+                const bool ok = sniffer_inject_c2s(make_c2s(st.op, st.payload));
+                log::info("Dev script: c2s {} ({} bytes){}", st.op, st.payload.size(), ok ? "" : " NOT sent");
+            } else {
+                puppet_inject_s2c_batch({{st.op, st.payload}});
+                log::info("Dev script: s2c {} ({} bytes)", st.op, st.payload.size());
+            }
+        }
+    }).detach();
+    return packets;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_script.h b/upstream/cd-coop-3446/src/mod/net/dev_script.h
new file mode 100644
index 0000000..f49cdc2
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_script.h
@@ -0,0 +1,26 @@
+#pragma once
+// Co-op+ dev: send hand-written Troc packets from a text file (research on one PC: dev stage/minigame requests,
+// sequencer messages). Bound to Ctrl+Shift+F6 when [dev] script=<path> is set. Never used in normal play.
+//
+// File format, one packet per line ('#' starts a comment, blank lines skipped):
+//   c2s <opcode> <hex payload>     (injected as if the client sent it)
+//   s2c <opcode> <hex payload>     (injected as if the server sent it)
+//   wait <ms>                      (pause before the next line, at most 10 s)
+//   tp <x> <y> <z>                 (move our player there with the hopped teleport, revive_prompt.h)
+//   poke <hex address> <hex bytes>  (write game memory: research only; the page must be writable)
+//   time <hh:mm>                   (set our time of day, time_sync.h)
+//   day <+N>                       (N days later, same hour)
+//   watch <hex addr> [len] [hits]  (hardware write breakpoint, dev_watch.h; logs who writes it)
+// Placeholders in the payload: {P} = our player key (u32), {POS} = our position (3 x f32), {U} = our user key (u32).
+// Spaces inside the hex are ignored. Opcodes are decimal.
+
+#include <cstdint>
+#include <string>
+
+namespace cdmp::net {
+
+// Runs the file on a worker thread (so "wait" never blocks the network loop). Returns the number of packets queued,
+// or -1 when the file cannot be read.
+int dev_script_run(const std::string& path, uint32_t own_player, float x, float y, float z);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp b/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp
new file mode 100644
index 0000000..b8443f6
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp
@@ -0,0 +1,125 @@
+#include "mod/net/dev_watch.h"
+
+#include <windows.h>
+#include <tlhelp32.h>
+
+#include <atomic>
+#include <cstring>
+#include <format>
+#include <string>
+#include <thread>
+
+#include "mod/log.h"
+
+namespace cdmp::net {
+namespace {
+
+struct Hit {
+    uint64_t rip, regs[16];
+    float xmm0, xmm1;
+    uint64_t stack[64];  // the first 64 qwords at rsp (return addresses among them)
+};
+
+constexpr int kMaxHits = 16;
+Hit g_hits[kMaxHits];
+std::atomic<int> g_count{0};
+std::atomic<int> g_want{0};
+std::atomic<bool> g_armed{false};
+PVOID g_handler = nullptr;
+
+LONG CALLBACK on_exception(EXCEPTION_POINTERS* e) {
+    if (e->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP || !(e->ContextRecord->Dr6 & 1)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    CONTEXT* c = e->ContextRecord;
+    c->Dr6 = 0;
+    if (g_armed.load()) {
+        const int i = g_count.fetch_add(1);
+        if (i < kMaxHits && i < g_want.load()) {
+            Hit& h = g_hits[i];
+            h.rip = c->Rip;
+            const uint64_t r[16] = {c->Rax, c->Rcx, c->Rdx, c->Rbx, c->Rsp, c->Rbp, c->Rsi, c->Rdi,
+                                    c->R8,  c->R9,  c->R10, c->R11, c->R12, c->R13, c->R14, c->R15};
+            std::memcpy(h.regs, r, sizeof r);
+            std::memcpy(&h.xmm0, &c->Xmm0, 4);
+            std::memcpy(&h.xmm1, &c->Xmm1, 4);
+            std::memcpy(h.stack, reinterpret_cast<const void*>(c->Rsp), sizeof h.stack);  // our own thread's stack
+        }
+        if (i + 1 >= g_want.load()) c->Dr7 &= ~1ull;  // this thread stops; the others are cleared by the worker
+    } else {
+        c->Dr7 &= ~1ull;
+    }
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+// Dr0 = addr and its enable bits on every thread of the game except the caller.
+void set_all(uintptr_t addr, int len, bool on) {
+    const DWORD me = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap == INVALID_HANDLE_VALUE) return;
+    THREADENTRY32 te{sizeof te};
+    const uint64_t lenbits = len == 1 ? 0 : len == 2 ? 1 : len == 8 ? 2 : 3;
+    int n = 0;
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+        if (te.th32OwnerProcessID != pid || te.th32ThreadID == me) continue;
+        HANDLE t = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_SUSPEND_RESUME, FALSE, te.th32ThreadID);
+        if (!t) continue;
+        if (SuspendThread(t) != static_cast<DWORD>(-1)) {
+            CONTEXT c{};
+            c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+            if (GetThreadContext(t, &c)) {
+                if (on) {
+                    c.Dr0 = addr;
+                    c.Dr7 = (c.Dr7 & ~(0xFull << 16)) | 1ull | (1ull << 16) | (lenbits << 18);  // L0, write, length
+                } else {
+                    c.Dr7 &= ~1ull;
+                }
+                if (SetThreadContext(t, &c)) ++n;
+            }
+            ResumeThread(t);
+        }
+        CloseHandle(t);
+    }
+    CloseHandle(snap);
+    log::info("Dev watch: {} on {} threads", on ? "set" : "cleared", n);
+}
+
+}  // namespace
+
+void dev_watch_start(uintptr_t addr, int len, int hits) {
+    if (g_armed.exchange(true)) {
+        log::warn("Dev watch: one is already running");
+        return;
+    }
+    if (!g_handler) g_handler = AddVectoredExceptionHandler(1, on_exception);
+    g_count = 0;
+    g_want = std::min(hits, kMaxHits);
+    std::thread([addr, len] {
+        set_all(addr, len, true);
+        log::info("Dev watch: writes to 0x{:X} ({} bytes)", addr, len);
+        for (int i = 0; i < 300 && g_count.load() < g_want.load(); ++i) Sleep(100);  // at most 30 s
+        set_all(addr, len, false);
+        g_armed = false;
+        const auto base = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+        const int n = std::min(g_count.load(), g_want.load());
+        for (int i = 0; i < n; ++i) {
+            const Hit& h = g_hits[i];
+            log::info("Dev watch: hit {} at exe+0x{:X} | rax {:X} rcx {:X} rdx {:X} rbx {:X} rsi {:X} rdi {:X} r8 {:X} "
+                      "r9 {:X} r14 {:X} r15 {:X} | xmm0 {} xmm1 {}",
+                      i, h.rip - base, h.regs[0], h.regs[1], h.regs[2], h.regs[3], h.regs[6], h.regs[7], h.regs[8],
+                      h.regs[9], h.regs[14], h.regs[15], h.xmm0, h.xmm1);
+            if (i == 0) {
+                std::string code;
+                for (int k = 0; k < 64; ++k) {
+                    if (h.stack[k] > base + 0x1000 && h.stack[k] < base + 0x6000000) {
+                        code += std::format(" [rsp+0x{:X}]=exe+0x{:X}", k * 8, h.stack[k] - base);
+                    }
+                }
+                log::info("Dev watch: code addresses on the stack:{}", code);
+            }
+        }
+        if (n == 0) log::info("Dev watch: no writes to 0x{:X} in 30 s", addr);
+    }).detach();
+}
+
+}  // namespace cdmp::net
