+bool guest_hits_we_hit(uint32_t key, uint64_t within_ms) {
+    std::lock_guard lock(g_mutex);
+    const uint64_t now = now_ms();
+    for (auto it = g_pending.rbegin(); it != g_pending.rend() && now - it->ms <= within_ms; ++it) {
