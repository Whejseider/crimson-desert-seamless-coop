+    CHECK(scale_damage(1, 1.7f) == 1);
+    CHECK(scale_damage(0, 1.7f) == 0);
+    CHECK(scale_damage(20, 1.0f) == 20);
+    // Host blows: give back (1 - 1/k) of the loss, floored, never the whole loss.
