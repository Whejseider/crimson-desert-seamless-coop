+double guest_hits_action_damage(uint32_t hash) {
+    std::lock_guard lock(g_mutex);
+    double best = 0;
+    for (const auto& s : kSeedBase) {
+        if (static_cast<uint32_t>(s.act >> 32) == hash) best = std::max(best, s.hp);
