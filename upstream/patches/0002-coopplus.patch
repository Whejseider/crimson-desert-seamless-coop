+void send(Type t, const void* data, size_t n) {
+    std::vector<uint8_t> b(5 + n);
+    uint32_t seq;
+    {
+        std::lock_guard lock(g_mutex);
+        seq = g_seq_out++;
+    }
+    std::memcpy(b.data(), &seq, 4);
+    b[4] = t;
+    if (n) std::memcpy(b.data() + 5, data, n);
+    capture_emit_activity(std::move(b));
