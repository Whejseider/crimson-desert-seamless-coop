+// Co-op+ (T16): ChangeWantedStateAck 2324, IncreaseWantedPriceAck 2249, WantedAddCrimeRecordAck 2569 from our server.
+std::atomic<uint32_t> g_wanted_sent_at{0};
+void activity_observe_s2c(const uint8_t* packet, size_t size) {
+    if (size < 5) return;
+    uint16_t op = 0;
+    std::memcpy(&op, packet, 2);
+    if (op == 2380 && size >= 5 + 23) {  // PrepareSequencerAck: u32 stage at +19 (weather_sync.cpp kPrepKeyAt)
+        uint32_t key = 0;
+        std::memcpy(&key, packet + 5 + 19, 4);
+        if (const char* n = event_name(key)) {
+            static std::map<uint32_t, uint32_t> told;  // sniffer thread only
+            const uint32_t t = GetTickCount();
+            if (auto it = told.find(key); it != told.end() && t - it->second < 300000) return;
+            told[key] = t ? t : 1;
+            log::info("Activity: a world event started here: {} (stage {})", n, key);
+            send(kEvent, &key, 4);
+        }
+        return;
+    }
+    if (op != 2324 && op != 2249 && op != 2569) return;
+    const uint32_t now = GetTickCount();
+    const uint32_t last = g_wanted_sent_at.load();
+    if (last && now - last < 60000) return;  // one notice a minute is plenty
+    g_wanted_sent_at = now ? now : 1;
+    log::info("Activity: we are wanted now (message {}): telling the other player", op);
+    send(kWanted, nullptr, 0);
+}
+
+void activity_observe_c2s(const uint8_t* packet, size_t size) {
+    if (size < 5) return;
+    uint16_t op = 0;
+    std::memcpy(&op, packet, 2);
+    if (op == kOpActivateMiniGameReq && size >= 5 + 2) {
+        uint16_t id = 0;
+        std::memcpy(&id, packet + 5, 2);
+        log::info("Activity: we started a minigame (id 0x{:04X})", id);
+        send(kGameOn, &id, 2);
+    } else if (op == kOpSpawnMiniGameCharacterReq && size >= 5 + 9) {
+        // u8 4 | u64 the minigame's stage (sequencer) | u16 id | u32 opponent | ...
+        uint64_t seq = 0;
+        std::memcpy(&seq, packet + 6, 8);
+        g_match_stage = cinema_stage_key(seq);
+        g_match_on = true;
+        {
+            std::lock_guard lock(g_opp_mutex);
+            g_opp = Opponent{};
+        }
+        log::info("Activity: a match of {} (stage {})", activity_minigame_name(g_match_stage.load()), g_match_stage.load());
+    } else if (op == kOpJoinMiniGameReq && size >= 5 + 7 && g_match_on.load()) {
+        uint32_t key = 0;
+        std::memcpy(&key, packet + 5 + 3, 4);
+        if (key && key != capture_own_player_key()) {
+            std::lock_guard lock(g_opp_mutex);
+            g_opp.key = key;
+        }
+    } else if (op == kOpStartActionReq && size >= 5 + 0x15A && g_match_on.load()) {
+        uint32_t key = 0;
+        std::memcpy(&key, packet + 5, 4);
+        std::lock_guard lock(g_opp_mutex);
+        if (key && key == g_opp.key) {
+            std::memcpy(&g_opp.rot, packet + 5 + 0x13E, 16);  // wire::kActionRot / kActionPos
+            std::memcpy(&g_opp.pos, packet + 5 + 0x14E, 12);
+            g_opp.posed = std::isfinite(g_opp.pos.x) && std::isfinite(g_opp.pos.z) && std::isfinite(g_opp.rot.w);
+        }
+    } else if (op == kOpLeaveMiniGameReq && size >= 5 + 23) {
+        g_match_on = false;
+        uint32_t stage = 0;
+        std::memcpy(&stage, packet + 5 + 19, 4);
+        log::info("Activity: we finished {} (stage {})", activity_minigame_name(stage), stage);
+        send(kGameOff, &stage, 4);
+    }
+}
+
+void activity_on_event(const std::vector<uint8_t>& p) {
+    if (p.size() < 5) return;
+    uint32_t seq = 0;
+    std::memcpy(&seq, p.data(), 4);
+    std::lock_guard lock(g_mutex);
+    if (seq <= g_seq_in && g_seq_in - seq < 0x10000) return;  // a repeat (each event is sent three times)
+    g_seq_in = seq;
+    std::array<float, 3> pos{};
+    if (p.size() >= 5 + 12) std::memcpy(pos.data(), p.data() + 5, 12);
+    switch (p[4]) {
+        case kCutsceneOn: g_partner_cutscene = true; g_partner_cut_pos = pos; g_partner_skip = false; break;
+        case kCutsceneOff: g_partner_cutscene = false; g_partner_skip = false; break;
+        case kSkip: g_partner_skip = true; g_skip_from = pos; break;
+        case kGameOn: g_toasts.push_back("{} is playing a minigame"); g_partner_game = true; break;
+        case kVersus:  // u8 live | u32 presses since their match started | f32 gauge (the host's)
+            if (p.size() >= 5 + 9) {
+                g_vs.partner_live = p[5] != 0;
+                std::memcpy(&g_vs.partner_count, p.data() + 6, 4);
+                std::memcpy(&g_vs.partner_gauge, p.data() + 10, 4);
+                g_vs.partner_seen = GetTickCount();
+            }
+            break;
+        case kGameOff: {
+            uint32_t stage = 0;
+            if (p.size() >= 9) std::memcpy(&stage, p.data() + 5, 4);
+            g_toasts.push_back("{} finished " + activity_minigame_name(stage));
+            g_partner_game = false;
+            break;
+        }
+        case 7: case 8: case 9:  // stage_cinema.h (it takes its own lock)
+        case kDuel:              // coop_duel.h, below
+        case kQuest:             // party_quests.h, below
+        case kMenu:
+            if (p.size() >= 6) {
+                const bool open = p[5] != 0;
+                if (g_partner_menu.exchange(open) != open) {
+                    aggro_set_partner_in_menu(open);
+                    log::info("Activity: the other player {} a menu", open ? "is in" : "left");
+                }
+            }
+            break;
+        case kLooted:  // Co-op+ (T10) first_come: u8 1 = the host looted (data: our copy key) / 0 = the guest did
+            if (p.size() >= 10) {
+                uint32_t copy = 0;
+                std::memcpy(&copy, p.data() + 6, 4);
+                if (p[5] == 1) loot_partner_looted(copy);
+                else enemy_partner_looted_copy(copy);
+            }
+            break;
+        case kWanted:
+            g_toasts.push_back("{} is now wanted by the guards (in their own world)");
+            break;
+        case kEvent:
+            if (p.size() >= 9) {
+                uint32_t key = 0;
+                std::memcpy(&key, p.data() + 5, 4);
+                if (const char* n = event_name(key)) g_toasts.push_back(std::string("World event near {}\n") + n);
+            }
+            break;
+        case kChat:              // coop_chat.h, below
+        case kTravel:            // coop_travel.h, below
+        case kReviveYou:         // coop_revive.h, below
+        case kHunt:              // coop_hunt.h, below
+        case 15:                 // coop_sync.h, below
+            break;
+        case kChallenge:  // u8 action | u32 stage key
+            if (p.size() >= 10) {
+                uint32_t stage = 0;
+                std::memcpy(&stage, p.data() + 6, 4);
+                const std::string game = activity_minigame_name(stage);
+                switch (p[5]) {
+                    case kInvite:
+                        // [dev] challenge_test with the echo peer: our own invite comes back; it is not theirs.
+                        if (g_challenge_test.load() && g_ch.state == kChSent && g_ch.stage == stage) break;
+                        g_ch = Challenge{};
+                        g_ch.state = kChReceived;
+                        g_ch.stage = stage;
+                        g_ch.since = GetTickCount();
+                        g_toasts.push_back("{} challenges you to " + game + "! {{Challenge}} to accept");
+                        break;
+                    case kAccept:
+                        if (g_ch.state == kChSent) {
+                            g_ch.state = kChOn;
+                            g_toasts.push_back("{} accepted: " + game + "! " + escape_braces(how_to_play(stage)));
+                        }
+                        break;
+                    case kDecline:
+                        if (g_ch.state == kChSent) g_ch.state = kChNone;
+                        g_toasts.push_back("{} declined the challenge");
+                        break;
+                    case kEnd:
+                        if (g_ch.state != kChNone) {
+                            g_toasts.push_back(std::format("{{}} ended the challenge. Final series: you {} - {}", g_ch.ours,
+                                                           g_ch.theirs));
+                        }
+                        g_ch = Challenge{};
+                        break;
+                    default: break;
+                }
+            }
+            break;
+        case kRps:  // u8 hand (0 scissors, 1 paper, 2 rock): their pick in the duel
+            if (p.size() >= 6 && p[5] < 3) g_rps.theirs = p[5];
+            break;
+        default: break;
+    }
+    if (p[4] >= 7 && p[4] <= 9) cinema_on_event(p[4], p.data() + 5, p.size() - 5);
+    if (p[4] == kDuel) duel_on_event(p.data() + 5, p.size() - 5);  // coop_duel.h (its own lock)
+    if (p[4] == kQuest) party_quests_on_event(p.data() + 5, p.size() - 5);  // party_quests.h (its own lock)
+    if (p[4] == kHunt) hunt_on_event(p.data() + 5, p.size() - 5);  // coop_hunt.h (its own lock)
+    if (p[4] == 15) sync_on_event(p.data() + 5, p.size() - 5);      // coop_sync.h (its own lock)
+    if (p[4] == kReviveYou) revive_partner_on_event();              // coop_revive.h
+    if (p[4] == kTravel) travel_on_event(p.data() + 5, p.size() - 5);  // coop_travel.h
+    if (p[4] == kChat) chat_on_event(p.data() + 5, p.size() - 5);      // coop_chat.h
+}
+
+ActivityTick activity_tick(bool connected, bool host, bool focused, std::optional<std::array<float, 3>> me,
+                           std::optional<std::array<float, 3>> partner, const std::string& partner_name,
+                           uint32_t now) {
+    // [dev] event_test (T22): announce a world event 20 s after connecting.
+    {
+        static uint32_t linked_at = 0;
+        static bool done = false;
+        if (!connected) linked_at = 0, done = false;
+        else if (!linked_at) linked_at = now ? now : 1;
+        if (const uint32_t key = g_event_test.load(); key && connected && !done && now - linked_at >= 20000) {
+            done = true;
+            log::info("Activity: [dev] event_test: announcing stage {} ({})", key, event_name(key) ? event_name(key) : "?");
+            send(kEvent, &key, 4);
+        }
+    }
+    // Co-op+ (T10) first_come: bodies we looted, to the other player.
+    if (connected) {
+        for (uint32_t copy : enemy_take_looted_originals()) {
+            uint8_t b[5] = {1};
+            std::memcpy(b + 1, &copy, 4);
+            send(kLooted, b, 5);
+        }
+        for (uint32_t copy : loot_take_looted_copies()) {
+            uint8_t b[5] = {0};
+            std::memcpy(b + 1, &copy, 4);
+            send(kLooted, b, 5);
+        }
+    }
+    // Co-op+ (T09): our menu state to the other player; theirs forgotten with the link.
+    {
+        static bool sent_open = false, was_linked = false;
+        static uint32_t sent_at = 0;
+        const bool open = game::ui_menu_open();
+        if (connected && (open != sent_open || !was_linked || now - sent_at >= kMenuResendMs)) {
+            const uint8_t b = open ? 1 : 0;
+            send(kMenu, &b, 1);
+            sent_open = open;
+            sent_at = now;
+        }
+        if (!connected && g_partner_menu.exchange(false)) aggro_set_partner_in_menu(false);
+        was_linked = connected;
+    }
+
+    ActivityTick out;
+    const bool cut = game::cutscene_playing().value_or(false);
+    boss_note_cutscene(cut);
+    // Our last known position (none while a minigame holds the player): what we send and measure from.
+    static std::array<float, 3> last_here{};
+    static bool have_here = false;
+    if (me) {
+        last_here = *me;
+        have_here = true;
+    }
+    const std::array<float, 3> here = last_here;
+    if (!me && have_here) me = last_here;
+    if (cut != g_last_cutscene) {
+        g_last_cutscene = cut;
+        g_cut_since = now;
+        g_skip_test_done = false;
+        {
+            std::lock_guard lock(g_mutex);
+            g_our_skip = false;
+            g_released = false;
+            if (g_skip_test) g_partner_skip = false;
+        }
+        g_hold_esc = false;
+        log::info("Activity: our cutscene {}", cut ? "started" : "ended");
+        if (connected) {
+            if (cut) send(kCutsceneOn, here.data(), 12);
+            else send(kCutsceneOff, nullptr, 0);
+        }
+    }
+    pad_tick();
+    cinema_tick(connected, host, cut, me, partner, now);  // the host's stage cinematics for the guest (D38)
+    const std::string who = partner_name.empty() ? std::string("Your friend") : partner_name;
+    start_hook();
+    bool release = false, send_skip = false;
+    {
+        std::lock_guard lock(g_mutex);
+        if (!connected) {
+            g_partner_cutscene = false;
+            g_partner_skip = false;
+            g_toasts.clear();
+        }
+        if (g_skip_test && cut) {
+            // One-PC test: the "other player" is in the same cutscene and presses skip kSkipTestDelayMs in.
+            g_partner_cutscene = true;
+            g_partner_cut_pos = here;
+            if (!g_skip_test_done && now - g_cut_since > kSkipTestDelayMs) {
+                g_skip_test_done = true;
+                g_partner_skip = true;
+                g_skip_from = here;
+                log::info("Activity: [dev] skip_test: the other player pressed skip");
+            }
+        }
+        // Everyone in the cutscene must press skip (D32 as the user specified): while the other player is in a
+        // cutscene within kNearM, our own Esc is held back (keyboard hook) and only sent to them.
+        const bool partner_near = !me || dist_xz(here, g_partner_cut_pos) <= kNearM;
+        const bool shared = cut && (connected || g_skip_test) && g_partner_cutscene && partner_near;
+        g_hold_esc = shared && !g_released;
+        g_hold_seen = GetTickCount64();
+        if (g_esc_held.exchange(false) && shared && !g_our_skip) {
+            g_our_skip = true;
+            send_skip = true;  // sent below, outside g_mutex (send() takes it)
+        }
+        if (shared && g_our_skip && g_partner_skip && !g_released && focused) {
+            g_released = true;
+            g_hold_esc = false;
+            release = true;
+        }
+        if (!g_toasts.empty()) {
+            out.toast = std::vformat(g_toasts.front(), std::make_format_args(who));
+            g_toasts.erase(g_toasts.begin());
+        }
+        const bool is_near = !partner || !me || dist_xz(*partner, here) <= kNearM;
+        if (g_partner_cutscene && is_near && !cut) {
+            out.banner = std::format("{} is watching a cutscene", who);
+        } else if (shared && g_our_skip && !g_partner_skip) {
+            out.banner = std::format("Skip: waiting for {}", who);
+        } else if (shared && g_partner_skip && !g_our_skip) {
+            out.banner = std::format("{} wants to skip: {{Skip}} to skip together", who);
+        } else if (shared && !g_released) {
+            out.banner = std::format("{} is in this cutscene too: it skips when you both press {{Skip}}", who);
+        }
+    }
+    if (send_skip) {
+        log::info("Activity: we pressed skip; waiting for the other player");
+        send(kSkip, here.data(), 12);
+    }
+    if (release) {
+        press_escape();
+        log::info("Activity: both players pressed skip; skipping");
+    }
+    versus_tick(out, connected, host, cut, who, now);
+    rps_tick(out, connected, who);
+    challenge_tick(out, connected, focused, me, who);
+    bool duel_on = false, inviter = false;
+    {
+        std::lock_guard lock(g_mutex);
+        duel_on = g_ch.state == kChOn && game_of(g_ch.stage) == kGameDuel;
+        inviter = g_ch.inviter;
+    }
+    DuelTick d = duel_tick(duel_on, inviter, connected, me, partner, who, now);
+    if (d.round_result) {
+        std::lock_guard lock(g_mutex);
+        (d.round_result == 1 ? g_ch.ours : g_ch.theirs) += 1;
+        out.toast = std::format("Duel\n{}   Series: you {} - {} {}", d.round_result == 1 ? "The round is yours."
+                                                                                         : "The round goes to " + who + ".",
+                                g_ch.ours, g_ch.theirs, who);
+        log::info("Activity: duel round to {}; series {} - {}", d.round_result == 1 ? "us" : "them", g_ch.ours,
+                  g_ch.theirs);
+    }
+    if (!d.banner.empty()) out.banner = std::move(d.banner);
+    if (!d.toast.empty() && out.toast.empty()) out.toast = std::move(d.toast);
+    bool hunt_on = false;
+    {
+        std::lock_guard lock(g_mutex);
+        hunt_on = g_ch.state == kChOn && game_of(g_ch.stage) == kGameHunt;
+    }
+    HuntTick h = hunt_tick(hunt_on, connected, who);
+    if (h.round_result) {
+        std::lock_guard lock(g_mutex);
+        if (h.round_result == 1) ++g_ch.ours;
+        if (h.round_result == 2) ++g_ch.theirs;
+        out.toast = std::format("Hunting contest\n{}   Series: you {} - {} {}",
+                                h.round_result == 1 ? std::string("The hunt is yours.")
+                                : h.round_result == 2 ? who + " takes the hunt." : std::string("An even hunt."),
+                                g_ch.ours, g_ch.theirs, who);
+    }
+    if (!h.banner.empty()) out.banner = std::move(h.banner);
+    if (!h.toast.empty() && out.toast.empty()) out.toast = std::move(h.toast);
+    // The party journal (party_quests.h): the other player's completed quests. Held back while another notice shows.
+    static uint32_t journal_after = 0;
+    if (out.toast.empty() && static_cast<int32_t>(now - journal_after) >= 0) {
+        if (std::string j = party_quests_tick(connected, who); !j.empty()) {
+            out.toast = std::move(j);
+            journal_after = now + 6500;
+        }
+    } else if (!out.toast.empty()) {
+        journal_after = now + 6500;
+    }
+    return out;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_activity.h b/upstream/cd-coop-3446/src/mod/net/coop_activity.h
new file mode 100644
index 0000000..24a4da1
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_activity.h
@@ -0,0 +1,93 @@
+#pragma once
+// Co-op+: shared activities (cutscenes and minigames), EventKind::Activity.
+//
+// Cutscenes run inside each player's own client: the server only sees side effects, there is no "start" or "skip"
+// message (captures of the Hernand pub arm wrestling intro, 2026-11-02). We read the game's "cutscene playing" flag
+// (game::cutscene_playing) and tell the other player when ours starts and ends. Skipping needs everyone: while the
+// other player is in a cutscene too, within kNearM of us, a keyboard hook holds back our Esc and only tells them we
+// pressed it; when both have pressed, each mod gives its own game the Esc (D32 as revised by the user 2026-11-02).
+// If the other player is not in a cutscene near us, Esc works as in the game.
+//
+// Minigames: the client asks the server to start one (ActivateMiniGameReq / JoinMiniGameReq), the server spawns the
+// NPC opponent (SpawnMiniGameCharacterReq/Ack), the match itself is simulated in the client, and the end is
+// LeaveMiniGameReq (names the minigame's stage) + MiniGameResultReq. We tell the other player "started" and
+// "finished <game>"; the result bytes did not differ between a win and a loss, so no winner is claimed.
+//
+// Payload: u32 sequence | u8 type | data. Sent three times on the lossy channel; the receiver drops repeats.
+//   type 1 cutscene started | f32 x, y, z     type 2 cutscene ended     type 3 skip pressed | f32 x, y, z
+//   type 4 minigame started | u16 minigame id  type 5 minigame finished | u32 stage key
+//   type 6 versus (10 Hz in a match) | u8 in a match | u32 E presses this match | f32 gauge (the host's)
+// Versus arm wrestling (D35): when both players are in a match (each at their own table), the host owns one gauge
+// that both players' E presses push; each mod writes it into its game (game::minigame_gauge_address), so the one who
+// reaches 100 wins on both screens.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace cdmp::net {
+
+// Client requests we watch (minigame start/end).
+void activity_observe_c2s(const uint8_t* packet, size_t size);
+// Co-op+ (T16): our server's messages: we became wanted (ChangeWantedStateAck / IncreaseWantedPriceAck / a new crime
+// record): the other player gets a notice. Crimes and bounties stay with the player who committed them.
+void activity_observe_s2c(const uint8_t* packet, size_t size);
+
+// An Activity event from the other player.
+void activity_on_event(const std::vector<uint8_t>& payload);
+
+struct ActivityTick {
+    std::string banner;  // persistent line while the other player is in a cutscene ("" = none)
+    std::string toast;   // one-off message ("" = none)
+};
+
+// Network loop, every frame: reads our cutscene flag, our Esc key, and applies the other player's skips.
+// `me` / `partner`: positions (partner unset = not connected). `focused`: the game window is in front.
+ActivityTick activity_tick(bool connected, bool host, bool focused, std::optional<std::array<float, 3>> me,
+                           std::optional<std::array<float, 3>> partner, const std::string& partner_name,
+                           uint32_t now_ms);
+
+// [dev] skip_test: one-PC test of the shared skip: during each of our cutscenes act as if the other player were in it
+// too and pressed skip 6 s in (the echo peer cannot press keys).
+void activity_set_skip_test(bool on);
+
+// [dev] versus_test: one-PC test of versus arm wrestling: a simulated other player in every match of ours, pushing
+// this many times a second (0 = off).
+void activity_set_versus_test(int presses_per_s);
+// Co-op+ (T09): the other player is in a menu now (their name tag says so).
+bool activity_partner_in_menu();
+// [dev] seat_test: in any arm / hand wrestling match against the NPC (no versus, no challenge), the other player's
+// copy takes the NPC's seat and the NPC is hidden (F9 one-PC test: the echo copy plays our own actions there).
+void activity_set_seat_test(bool on);
+// [dev] event_test (T22): this stage key is announced as a world event 20 s after connecting.
+void activity_set_event_test(uint32_t key);
+
+// [dev] challenge_test: one-PC test of challenges: 1 = a simulated other player accepts our Shift+F5 invite after
+// 2 s; 2 = also Shift+F6 (with nothing pending) makes them challenge us to a rock-paper-scissors duel.
+void activity_set_challenge_test(int mode);
+
+// [dev] rps_test: one-PC test of the RPS duel: a simulated other player who always shows this hand (0 scissors,
+// 1 paper, 2 rock; -1 = off), 4 s after our pick.
+void activity_set_rps_test(int hand);
+
+// Another Co-op+ module's Activity event (stage_cinema: types 7..9), on the same sequence as ours.
+void activity_send(uint8_t type, const std::vector<uint8_t>& data);
+
+// The rock-paper-scissors duel as the overlay shows it over the two characters (render/hud.cpp): while a duel is on,
+// "choosing" / "picked" over each, and at the reveal both hands (0 scissors, 1 paper, 2 rock) with the winner.
+struct RpsView {
+    bool on = false;
+    int ours = -1, theirs = -1;     // shown hands (-1: none yet / hidden)
+    bool ours_picked = false, theirs_picked = false;
+    int winner = 0;                 // at the reveal: 1 us, 2 them, 0 a draw
+    float reveal_t = -1;            // seconds into the reveal (-1 not revealing)
+};
+RpsView activity_rps_view();
+
+// Human name of a minigame stage key ("arm wrestling"...), "a minigame" when unknown.
+std::string activity_minigame_name(uint32_t stage_key);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_chat.cpp b/upstream/cd-coop-3446/src/mod/net/coop_chat.cpp
new file mode 100644
index 0000000..b1dffba
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_chat.cpp
@@ -0,0 +1,198 @@
+#include "mod/net/coop_chat.h"
+
+#include <windows.h>
+
+#include <array>
+#include <atomic>
+#include <deque>
+#include <format>
+#include <mutex>
+
+#include "mod/input/actions.h"
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+
+namespace cdmp::net {
+namespace {
+
+constexpr uint8_t kChatType = 22;
+constexpr size_t kMaxText = 120;
+constexpr uint32_t kQuickMs = 8000;
+constexpr uint32_t kLogMs = 15000;
+constexpr size_t kLogLines = 4;
+constexpr std::array<const char*, 8> kQuick = {"Go here", "Danger here!", "Loot here", "Follow me",
+                                               "Wait for me",  "Help!",        "Thanks!",   "Ready?"};
+constexpr int kHereCount = 3;  // the first three drop a map pin
+
+std::mutex g_mutex;
+std::atomic<bool> g_open{false};  // the text line is open (the hook reads it)
+std::string g_text;
+bool g_send = false, g_cancel = false;
+std::atomic<bool> g_quick{false};
+std::atomic<int> g_quick_step{0};
+int g_quick_index = 0;
+uint32_t g_quick_since = 0;
+struct Line {
+    uint32_t at;
+    std::string text;
+};
+std::deque<Line> g_log;
+std::deque<std::string> g_incoming;  // from the event, shown by the tick
+
+std::string sanitize(std::string s) {
+    for (char& c : s) {
+        if (static_cast<unsigned char>(c) < 0x20) c = ' ';
+    }
+    if (s.size() > kMaxText) s.resize(kMaxText);
+    return s;
+}
+
+void add_log(const std::string& text, uint32_t now) {
+    g_log.push_back({now, text});
+    while (g_log.size() > kLogLines) g_log.pop_front();
+}
+
+}  // namespace
+
+bool chat_quick_open() { return g_quick.load(); }
+void chat_quick_step(int delta) { g_quick_step.fetch_add(delta); }
+
+std::atomic<uint64_t> g_taken[4];  // key-downs we took (by vk bit): only their key-ups are ours too
+std::atomic<bool> g_open_request{false};  // Shift+F2 seen by the hook (not GetAsyncKeyState: unreliable here, chat2-4)
+std::atomic<bool> g_shift{false};         // Shift as the hook saw it
+
+bool chat_hook_key(uint32_t vk, uint32_t scan, bool down) {
+    const uint64_t bit = 1ull << (vk & 63);
+    std::atomic<uint64_t>& taken = g_taken[(vk >> 6) & 3];
+    if (vk == VK_SHIFT || vk == VK_LSHIFT || vk == VK_RSHIFT) g_shift = down;
+    if (!down) {
+        // Only the release of a key whose press we took.
+        return (taken.fetch_and(~bit) & bit) != 0;
+    }
+    if (!g_open.load()) {
+        // The Chat action's own key (Shift+F2): only noted, never swallowed. Swallowing half of a press leaves the
+        // key "held" for GetAsyncKeyState, and a held F2 + Ctrl is the Leave action (chat6: Ctrl+F3 left the session).
+        const auto& b = input::binding(input::Action::Chat);
+        if (vk == static_cast<uint32_t>(b.vk) && g_shift.load() == b.shift && !(GetAsyncKeyState(VK_CONTROL) & 0x8000)) {
+            g_open_request = true;
+        }
+        return false;
+    }
+    if (vk == VK_F2) return false;  // the same rule while the line is open
+    taken.fetch_or(bit);
+    std::lock_guard lock(g_mutex);
+    if (vk == VK_RETURN) {
+        g_send = true;
+    } else if (vk == VK_ESCAPE) {
+        g_cancel = true;
+    } else if (vk == VK_BACK) {
+        if (!g_text.empty()) g_text.pop_back();
+    } else if (g_text.size() < kMaxText) {
+        BYTE state[256] = {};
+        if (GetKeyState(VK_SHIFT) & 0x8000) state[VK_SHIFT] = 0x80;
+        if (GetKeyState(VK_CAPITAL) & 1) state[VK_CAPITAL] = 1;
+        wchar_t w[4] = {};
+        const int n = ToUnicode(vk, scan, state, w, 4, 0);
+        if (n == 1 && w[0] >= 0x20 && w[0] < 0x7F) g_text += static_cast<char>(w[0]);
+    }
+    return true;
+}
+
+void chat_on_event(const uint8_t* d, size_t n) {
+    if (n < 1) return;
+    std::string text;
+    if (d[0] == 0) {
+        text = sanitize(std::string(reinterpret_cast<const char*>(d + 1), n - 1));
+    } else if (d[0] <= kQuick.size()) {
+        text = kQuick[d[0] - 1];
+    }
+    if (text.empty()) return;
+    std::lock_guard lock(g_mutex);
+    if (g_incoming.size() < 16) g_incoming.push_back(std::move(text));
+}
+
+ChatView chat_tick(bool connected, const std::string& name, bool focused, uint32_t now) {
+    ChatView v;
+    const std::string who = name.empty() ? std::string("Your friend") : name;
+    static input::Edge ping_key;
+    const bool chat_pressed = g_open_request.exchange(false) && focused;
+    const bool ping_down = input::action_down(input::Action::Ping, focused);
+    const bool ping_pressed = ping_key(ping_down);
+
+    std::vector<uint8_t> out;
+    {
+        std::lock_guard lock(g_mutex);
+        // Incoming.
+        while (!g_incoming.empty()) {
+            const std::string line = who + ": " + g_incoming.front();
+            add_log(line, now);
+            v.toast = "Co-op\n" + line;
+            g_incoming.pop_front();
+        }
+        if (!connected) {
+            g_open = false;
+            g_quick = false;
+            g_text.clear();
+        }
+        // The text line.
+        if (connected && chat_pressed && !g_open.load() && !g_quick.load()) {
+            log::info("Chat: line opened");
+            g_open = true;
+            g_text.clear();
+            g_send = g_cancel = false;
+        }
+        if (g_open.load()) {
+            if (g_cancel || (g_send && g_text.empty())) {
+                g_open = false;
+            } else if (g_send) {
+                out.push_back(0);
+                out.insert(out.end(), g_text.begin(), g_text.end());
+                add_log("You: " + g_text, now);
+                log::info("Chat: we said \"{}\"", g_text);
+                g_open = false;
+            } else {
+                v.input = "Say: " + g_text + "_      Enter send   Esc cancel";
+            }
+            g_send = g_cancel = false;
+        }
+        // The quick list.
+        if (connected && ping_pressed && !g_open.load()) {
+            if (!g_quick.load()) {
+                g_quick = true;
+                g_quick_index = 0;
+                g_quick_since = now;
+                g_quick_step = 0;
+            } else {
+                const int i = g_quick_index;
+                out.push_back(static_cast<uint8_t>(i + 1));
+                add_log(std::string("You: ") + kQuick[i], now);
+                v.ping = i < kHereCount;
+                g_quick = false;
+                log::info("Chat: quick message \"{}\"", kQuick[i]);
+            }
+        }
+        if (g_quick.load()) {
+            const int step = g_quick_step.exchange(0);
+            if (step) {
+                g_quick_index = (g_quick_index + step % 8 + 8) % 8;
+                g_quick_since = now;
+            }
+            if (now - g_quick_since > kQuickMs) {
+                g_quick = false;
+            } else {
+                std::string list;
+                for (int i = 0; i < static_cast<int>(kQuick.size()); ++i) {
+                    list += i == g_quick_index ? std::format("  {{*}}{}{{*}}", kQuick[i]) : std::format("  {}", kQuick[i]);
+                }
+                v.quick = "Message:" + list + "      {MenuPrev}{MenuNext} choose   {Ping} send";
+            }
+        }
+        // The log.
+        while (!g_log.empty() && now - g_log.front().at > kLogMs) g_log.pop_front();
+        for (const auto& l : g_log) v.log.push_back(l.text);
+    }
+    if (!out.empty()) activity_send(kChatType, out);
+    return v;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_chat.h b/upstream/cd-coop-3446/src/mod/net/coop_chat.h
new file mode 100644
index 0000000..7467e58
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_chat.h
@@ -0,0 +1,39 @@
+#pragma once
+// Co-op+ (roadmap T24): text chat and quick messages.
+//
+// Keyboard: the Chat action (Shift+F2) opens a line at the bottom ("Say: ..."); while it is open every key goes to
+// it (the keyboard hook keeps them from the game): Enter sends, Esc cancels, Backspace deletes. Keyboard and pad: the
+// Ping action (Ctrl+F3, pad View + D-pad Left) opens the quick list -- Go here, Danger, Loot here, Follow me, Wait,
+// Help!, Thanks, Ready? -- MenuPrev / MenuNext choose (arrows, D-pad Left / Right), the Ping action again sends (the
+// three "here" ones also put a pin on the other player's map, as Ctrl+F3 did), it closes by itself after 8 s.
+// The other player sees the message as a notice and in a short chat log on the left (the last 4 lines, 15 s).
+// Activity type 22: u8 kind (0 text, 1.. quick message) | text (UTF-8, at most kMaxText bytes).
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace cdmp::net {
+
+struct ChatView {
+    std::string input;              // the open line ("" = closed); ends with a cursor
+    std::string quick;              // the open quick list ("" = closed)
+    std::vector<std::string> log;   // recent lines, oldest first
+    std::string toast;              // a notice for a message that just came in
+    bool ping = false;              // the chosen quick message is a "here" one: drop a map pin at our position now
+};
+
+// Network loop, every tick.
+ChatView chat_tick(bool connected, const std::string& partner_name, bool focused, uint32_t now_ms);
+
+// Activity type 22 from the other player.
+void chat_on_event(const uint8_t* data, size_t n);
+
+// Keyboard hook (its own thread): true = the key is ours (the chat line is open and the game is in front).
+bool chat_hook_key(uint32_t vk, uint32_t scan, bool down);
+
+// The quick list wants the arrow keys / D-pad Left-Right (the activity hook and pad code look at this).
+bool chat_quick_open();
+void chat_quick_step(int delta);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_duel.cpp b/upstream/cd-coop-3446/src/mod/net/coop_duel.cpp
new file mode 100644
index 0000000..4b526a3
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_duel.cpp
@@ -0,0 +1,387 @@
+#include "mod/net/coop_duel.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <deque>
+#include <format>
+#include <mutex>
+
+#include "mod/input/pad_input.h"
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+#include "mod/net/guest_hits.h"
+#include "mod/net/local_capture.h"
+#include "mod/net/player_hits.h"
+#include "mod/net/remote_puppet.h"
+#include "mod/net/wire_layout.h"
+
+namespace cdmp::net {
+namespace {
+
+constexpr uint8_t kDuelType = 12;  // Activity event type (coop_activity.cpp Type)
+enum Sub : uint8_t { kStart = 1, kHit = 2, kLost = 3 };
+enum Why : uint8_t { kDown = 1, kOut = 2 };
+enum Phase : uint8_t { kIdle, kWaitStart, kCountdown, kFight, kOver };
+
+constexpr uint16_t kOpStartActionReq = 2202;
+constexpr float kRadiusM = 20.0f;       // the duel ground
+constexpr uint32_t kOutMs = 10000;      // out of it this long in a row: the round is lost
+constexpr uint32_t kCountdownMs = 3000;
+constexpr uint32_t kFightTitleMs = 1200;  // "Fight!" stays this long
+constexpr uint32_t kOverMs = 6000;      // the result on screen, then the next round
+constexpr uint32_t kImpactMs = 280;     // a swing lands this long after it starts
+constexpr uint32_t kSwingGapMs = 220;   // one hit per swing: the same attack again within this is the same swing
+constexpr float kReachM = 3.2f;
+constexpr float kArcDeg = 65.0f;
+constexpr double kFloor = 0.03;         // a round is lost at 3% health (nobody dies in a duel)
+constexpr uint32_t kOurCharacterThere = 0xA010F001;
+
+struct Swing {
+    uint32_t hash = 0;
+    double base = 0;              // HP on a defence-1.0 enemy (guest_hits)
+    std::array<float, 3> pos{};
+    float fx = 0, fz = 1;         // facing (unit, XZ)
+    uint32_t at = 0;
+};
+
+struct State {
+    Phase phase = kIdle;
+    uint32_t round = 0;
+    std::array<float, 3> centre{};
+    float radius = kRadiusM;
+    uint32_t since = 0;           // phase start
+    uint32_t out_since = 0;       // 0 = inside
+    int64_t start_hp = -1;        // our HP when the round started (x1000)
+    int result = 0;               // the last round: 1 we won, 2 they did
+    Why why = kDown;
+    bool lost_sent = false;
+    float partner_hp = -1;
+    std::deque<Swing> swings;
+    std::deque<std::vector<uint8_t>> hits_in;  // PlayerHit payloads for us, applied by the tick
+    uint32_t last_swing_hash = 0, last_swing_at = 0;
+    bool have_start = false;      // the duel ground of `round` is known
+    bool reported = false;        // the round's result went to the challenge
+    uint32_t next_round = 0;      // the inviter's latest round start (guest side), its ground:
+    std::array<float, 3> next_centre{};
+    float next_radius = kRadiusM;
+} g;
+std::mutex g_mutex;
+std::atomic<bool> g_test{false};
+std::atomic<bool> g_on{false};  // a duel challenge is on (read by the c2s hook)
+std::atomic<uint32_t> g_attack_input_at{0};  // GetTickCount of the last attack button press (0 none)
+constexpr uint32_t kInputToActionMs = 350;   // the swing's StartAction follows the press within this
+constexpr double kUnknownBase = 15.0;        // an attack the damage tables do not know: a middling blow
+
+// The attack buttons (the game's controls, progression.md): weak / strong attack and kick. Mouse left / F on a
+// keyboard (right mouse aims or guards there), RB / RT / Y on a pad.
+bool attack_input_down() {
+    DWORD pid = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+    const bool focused = pid == GetCurrentProcessId();
+    if (focused && ((GetAsyncKeyState(VK_LBUTTON) & 0x8000) || (GetAsyncKeyState('F') & 0x8000))) return true;
+    return (input::pad_buttons() & (input::kPadRB | input::kPadRT | input::kPadY)) != 0 && !input::chord_held();
+}
+
+float dist_xz(const std::array<float, 3>& a, const std::array<float, 3>& b) {
+    const float dx = a[0] - b[0], dz = a[2] - b[2];
+    return std::sqrt(dx * dx + dz * dz);
+}
+
+void send(Sub sub, uint32_t round, const void* data, size_t n) {
+    std::vector<uint8_t> b(5 + n);
+    b[0] = sub;
+    std::memcpy(b.data() + 1, &round, 4);
+    if (n) std::memcpy(b.data() + 5, data, n);
+    activity_send(kDuelType, b);
+}
+
+float u_float(const uint8_t* p) {
+    float f;
+    std::memcpy(&f, p, 4);
+    return f;
+}
+
+}  // namespace
+
+void duel_set_test(bool on) { g_test = on; }
+
+void duel_observe_c2s(const uint8_t* packet, size_t size) {
+    if (!g_on || size != 5 + wire::kActionReqSize) return;
+    uint16_t op;
+    std::memcpy(&op, packet, 2);
+    if (op != kOpStartActionReq) return;
+    const uint8_t* p = packet + 5;
+    uint32_t key, hash;
+    std::memcpy(&key, p, 4);
+    std::memcpy(&hash, p + 4, 4);  // the action (the same hash the attack's frame events name)
+    if (!key || key != capture_own_player_key()) return;
+    double base = guest_hits_action_damage(hash);
+    if (base <= 0) {
+        // Not in the tables (attacks are learnt from fights against enemies): a swing when the player just pressed
+        // an attack button.
+        const uint32_t pressed = g_attack_input_at.load();
+        const bool swing = attack_input_down() || (pressed && GetTickCount() - pressed < kInputToActionMs);
+        if (!swing || !hash) return;
+        base = kUnknownBase;
+    }
+    // Facing from the actor's quaternion (x, y, z, w): yaw about +Y, forward = (-sin yaw, -cos yaw) on XZ
+    // (measured 2026-11-02: facing +X is (0, -0.717, 0, 0.697), facing +Z is (0, 1, 0, 0.019)).
+    const float qy = u_float(p + wire::kActionRot + 4), qw = u_float(p + wire::kActionRot + 12);
+    const float yaw = 2.0f * std::atan2(qy, qw);
+    Swing s;
+    s.hash = hash;
+    s.base = base;
+    for (int i = 0; i < 3; ++i) s.pos[i] = u_float(p + wire::kActionPos + 4 * i);
+    s.fx = -std::sin(yaw);
+    s.fz = -std::cos(yaw);
+    s.at = GetTickCount();
+    if (!std::isfinite(s.fx) || !std::isfinite(s.fz)) return;
+    std::lock_guard lock(g_mutex);
+    if (g.phase != kFight) return;
+    if (hash == g.last_swing_hash && s.at - g.last_swing_at < kSwingGapMs) return;
+    g.last_swing_hash = hash, g.last_swing_at = s.at;
+    if (g.swings.size() < 8) g.swings.push_back(s);
+}
+
+void duel_on_event(const uint8_t* d, size_t n) {
+    if (n < 5) return;
+    uint32_t round;
+    std::memcpy(&round, d + 1, 4);
+    std::lock_guard lock(g_mutex);
+    switch (d[0]) {
+        case kStart:
+            if (n >= 5 + 16 && round > g.next_round && !g_test) {
+                g.next_round = round;
+                for (int i = 0; i < 3; ++i) g.next_centre[i] = u_float(d + 5 + 4 * i);
+                g.next_radius = std::clamp(u_float(d + 17), 8.0f, 60.0f);
+            }
+            break;
+        case kHit:
+            if (round == g.round && g.phase == kFight && g.hits_in.size() < 8) {
+                g.hits_in.emplace_back(d + 5, d + n);
+            }
+            break;
+        case kLost:
+            if (round == g.round && (g.phase == kFight || g.phase == kCountdown) && !g_test) {
+                g.phase = kOver;
+                g.result = 1;
+                g.why = n >= 6 && d[5] == kOut ? kOut : kDown;
+                g.since = GetTickCount();
+                g.lost_sent = true;  // nothing for us to send
+            }
+            break;
+        default: break;
+    }
+}
+
+DuelTick duel_tick(bool on, bool inviter, bool connected, std::optional<std::array<float, 3>> me,
+                   std::optional<std::array<float, 3>> partner, const std::string& who, uint32_t now) {
+    DuelTick out;
+    now = GetTickCount();  // one clock with duel_hud and the c2s hook (the caller's is another)
+    g_on = on;
+    // Attack presses (rising edge), for duel_observe_c2s.
+    static bool attack_was = false;
+    const bool attack = on && attack_input_down();
+    if (attack && !attack_was) g_attack_input_at = now;
+    attack_was = attack;
+    // What our screen shows of them is where our swings land.
+    if (auto pp = puppet_position()) partner = std::array<float, 3>{pp->x, pp->y, pp->z};
+    std::vector<std::vector<uint8_t>> hits_in;
+    std::vector<Swing> swings;
+    std::optional<std::pair<Sub, std::vector<uint8_t>>> send_it;
+    int64_t heal = 0;
+    uint32_t round = 0;
+    {
+        std::lock_guard lock(g_mutex);
+        if (!on || (!connected && !g_test)) {
+            if (g.phase != kIdle) log::info("Duel: over");
+            g = State{};
+            return out;
+        }
+        const int64_t hp = hits_own_hp(), max = hits_own_hp_max();
+        switch (g.phase) {
+            case kIdle:
+            case kWaitStart: {
+                if (g.phase == kIdle) {
+                    g.phase = kWaitStart;
+                    g.round = 1;
+                    g.since = now;
+                    g.have_start = false;
+                }
+                if ((inviter || g_test) && !g.have_start) {
+                    // We place the duel ground: half way between us (or here, when they are not drawn).
+                    if (!me) break;
+                    g.centre = *me;
+                    if (partner && dist_xz(*me, *partner) < 60.0f) {
+                        for (int i = 0; i < 3; ++i) g.centre[i] = ((*me)[i] + (*partner)[i]) * 0.5f;
+                    }
+                    g.radius = kRadiusM;
+                    std::vector<uint8_t> b(16);
+                    std::memcpy(b.data(), g.centre.data(), 12);
+                    std::memcpy(b.data() + 12, &g.radius, 4);
+                    send_it = std::make_pair(kStart, std::move(b));
+                    g.have_start = true;
+                }
+                if (!g.have_start && g.next_round == g.round) {
+                    g.centre = g.next_centre;
+                    g.radius = g.next_radius;
+                    g.have_start = true;
+                } else if (!g.have_start && g.next_round > g.round) {
+                    g.round = g.next_round;  // they are a round ahead (we missed one): catch up
+                    break;
+                }
+                if (!g.have_start) {
+                    out.banner = std::format("Duel vs {}: waiting for {}", who, who);
+                    break;
+                }
+                g.phase = kCountdown;
+                g.since = now;
+                g.out_since = 0;
+                g.start_hp = -1;  // taken when the fight starts (a heal from the last round lands meanwhile)
+                g.lost_sent = false;
+                g.reported = false;
+                g.result = 0;
+                g.swings.clear();
+                g.hits_in.clear();
+                log::info("Duel: round {} at ({:.1f}, {:.1f}, {:.1f}), radius {:.0f} m", g.round, g.centre[0],
+                          g.centre[1], g.centre[2], g.radius);
+                break;
+            }
+            case kCountdown:
+                if (now - g.since >= kCountdownMs) {
+                    g.phase = kFight;
+                    g.since = now;
+                    g.start_hp = hp;
+                    log::info("Duel: fight (round {}, our hp {:.1f})", g.round, hp / 1000.0);
+                }
+                break;
+            case kFight: {
+                swings.assign(g.swings.begin(), g.swings.end());
+                g.swings.clear();
+                hits_in.assign(g.hits_in.begin(), g.hits_in.end());
+                g.hits_in.clear();
+                // Out of the duel ground too long, or brought down: the round is theirs.
+                const bool outside = me && dist_xz(*me, g.centre) > g.radius;
+                if (!outside) g.out_since = 0;
+                else if (!g.out_since) g.out_since = now;
+                std::optional<Why> lost;
+                if (g.out_since && now - g.out_since >= kOutMs) lost = kOut;
+                if (hp >= 0 && max > 0 && hp <= static_cast<int64_t>(max * kFloor) + 500) lost = kDown;
+                if (lost) {
+                    g.phase = kOver;
+                    g.result = 2;
+                    g.why = *lost;
+                    g.since = now;
+                    const uint8_t why = *lost;
+                    send_it = std::make_pair(kLost, std::vector<uint8_t>{why});
+                    log::info("Duel: we lost round {} ({})", g.round, *lost == kOut ? "out of the duel ground" : "down");
+                }
+                break;
+            }
+            case kOver:
+                if (now - g.since >= kOverMs) {
+                    // Back to the health we started the round with, then the next round.
+                    if (g.start_hp > 0 && hp >= 0 && hp < g.start_hp) heal = g.start_hp - hp;
+                    g.round += 1;
+                    g.phase = kWaitStart;
+                    g.since = now;
+                    g.have_start = false;
+                }
+                break;
+        }
+        round = g.round;
+    }
+    if (send_it) send(send_it->first, round, send_it->second.data(), send_it->second.size());
+    if (heal > 0) {
+        hits_vary_own_hp(heal);
+        log::info("Duel: healed back {:.1f} hp", heal / 1000.0);
+    }
+    // Our swings that reach them.
+    for (const Swing& s : swings) {
+        if (!partner) break;
+        // Judged at the impact: where they are now, from where we are now.
+        const auto from = me.value_or(s.pos);
+        const float dx = (*partner)[0] - from[0], dz = (*partner)[2] - from[2];
+        const float d = std::sqrt(dx * dx + dz * dz);
+        const float dy = std::fabs((*partner)[1] - from[1]);
+        const float cosang = d > 0.01f ? (dx * s.fx + dz * s.fz) / d : 1.0f;
+        // ([dev] duel_test: the echo copy always stands at our side, never in front: any direction.)
+        const float arc = g_test ? 180.0f : kArcDeg;
+        const bool hit = d <= kReachM && dy < 2.0f && cosang >= std::cos(arc * 3.14159265f / 180.0f);
+        log::info("Duel: our swing 0x{:08X} (base {:.1f}): {:.1f} m, {:.0f} deg -> {}", s.hash, s.base, d,
+                  std::acos(std::clamp(cosang, -1.0f, 1.0f)) * 57.2958f, hit ? "HIT" : "miss");
+        if (!hit) continue;
+        const auto payload = hits_make_pvp(s.hash, static_cast<int64_t>(s.base * 1000));
+        send(kHit, round, payload.data(), payload.size());
+    }
+    // Their swings on us.
+    for (auto& h : hits_in) {
+        const int64_t max = hits_own_hp_max();
+        if (h.size() < 16 || max <= 0) continue;
+        int64_t base;
+        std::memcpy(&base, h.data() + 8, 8);
+        // 4% of our health for the lightest blow up to 10% for the heaviest: 10..25 hits a round.
+        const double b = std::clamp(base / 1000.0, 0.0, 40.0);
+        const auto damage = static_cast<int64_t>(static_cast<double>(max) * (0.04 + b / 40.0 * 0.06));
+        std::memcpy(h.data() + 8, &damage, 8);
+        hits_on_pvp(h, static_cast<int64_t>(max * kFloor));
+    }
+    // What to say.
+    std::lock_guard lock(g_mutex);
+    if (g.phase == kOver && g.result && !g.reported) {
+        g.reported = true;
+        out.round_result = g.result;
+    }
+    if (g.phase == kFight && g.out_since) {
+        const int left = static_cast<int>((kOutMs - std::min(kOutMs, now - g.out_since) + 999) / 1000);
+        out.banner = std::format("Duel vs {}: round {}   (out of the duel ground: {} s)", who, g.round, left);
+    } else if (g.phase == kFight) {
+        out.banner = std::format("Duel vs {}: round {}", who, g.round);
+    }
+    return out;
+}
+
+DuelHud duel_hud() {
+    DuelHud h;
+    std::lock_guard lock(g_mutex);
+    if (g.phase == kIdle || (g.phase == kWaitStart && !g.have_start)) return h;
+    const uint32_t now = GetTickCount();
+    h.active = true;
+    h.centre = g.centre;
+    h.radius = g.radius;
+    const uint32_t t = now - g.since;
+    if (g.phase == kCountdown) {
+        const uint32_t left = (kCountdownMs - std::min(kCountdownMs, t) + 999) / 1000;
+        h.title = std::to_string(std::max<uint32_t>(left, 1));
+        h.subtitle = g.round == 1 ? "Stay within the duel ground" : std::format("Round {}", g.round);
+        h.title_color = 0xFF82C8E8;  // gold (ABGR)
+        h.title_alpha = 1.0f - static_cast<float>(t % 1000) / 1600.0f;
+    } else if (g.phase == kFight && t < kFightTitleMs) {
+        h.title = "Fight!";
+        h.title_color = 0xFF82C8E8;
+        h.title_alpha = 1.0f - static_cast<float>(t) / kFightTitleMs;
+    } else if (g.phase == kOver) {
+        const bool won = g.result == 1;
+        h.title = won ? "Victory" : "Defeat";
+        h.subtitle = won ? (g.why == kOut ? "Your opponent fled the duel ground" : "Your opponent yields")
+                         : (g.why == kOut ? "You left the duel ground" : "You yield");
+        h.title_color = won ? 0xFF82C8E8 : 0xFF2830C4;  // gold / the death screen's red
+        h.title_alpha = t < kOverMs - 1000 ? 1.0f : std::max(0.0f, (kOverMs - t) / 1000.0f);
+    }
+    if (g.phase == kFight && g.out_since) {
+        h.out_left_s = std::max(0.0f, (kOutMs - static_cast<float>(now - g.out_since)) / 1000.0f);
+        if (h.title.empty()) {
+            h.title = "Return to the duel ground";
+            h.subtitle = std::format("{:.0f} s, or the round is forfeit", std::ceil(h.out_left_s));
+            h.title_color = 0xFF2830C4;
+            h.title_alpha = 1.0f;
+        }
+    }
+    return h;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_duel.h b/upstream/cd-coop-3446/src/mod/net/coop_duel.h
new file mode 100644
index 0000000..68cebd9
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_duel.h
@@ -0,0 +1,67 @@
+#pragma once
+// Co-op+ duels (user 2026-11-02: "a duel system where you can duel your friends in a 1v1 PVP match ... inside of a set
+// radius ... if you get too far away from the dueling location for too long you automatically lose"). D41.
+//
+// A duel is a challenge game (coop_activity.h, Shift+F5 / chord + D-pad Up, "Duel" in the picker). Once accepted:
+//   * the duel ground: a circle of kRadiusM around the point between the two players, marked on the ground;
+//   * each round: 3, 2, 1, "Fight!"; the first brought to their knees (kFloor of their health, never killed) loses;
+//     out of the circle for kOutMs in a row also loses; then both are healed back to their health at the round's
+//     start and the next round begins; the series score is the challenge's;
+//   * hits: the two characters cannot hit each other in the game (each is a friendly copy in the other's world), so
+//     the attacker's mod judges them: our own attack (a StartActionReq whose action is a known attack, guest_hits.h),
+//     kImpactMs later, with the other player's character (as drawn on our screen) within kReachM in front of us
+//     (kArcDeg either side of our facing). The hit goes to them; their mod applies it through their own server
+//     (VaryStatByAccInputReq) with a stagger learnt from our fights (player_hits.h), so they flinch on both screens.
+//
+// Activity event type 12 (kDuel), u8 sub | u32 round | ...:
+//   1 round start (from the inviter)  f32 centre x, y, z | f32 radius
+//   2 hit on you                       PlayerHit payload (player_hits.h hits_make_pvp)
+//   3 I lost the round                 u8 why (1 brought down, 2 out of the duel ground)
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace cdmp::net {
+
+// The challenge "stage" of a duel (not a game stage: a key no stage uses).
+inline constexpr uint32_t kDuelStage = 0xD0E10001;
+
+// Our client requests: our swings.
+void duel_observe_c2s(const uint8_t* packet, size_t size);
+
+// A kDuel event from the other player (payload after the Activity header).
+void duel_on_event(const uint8_t* data, size_t n);
+
+struct DuelTick {
+    std::string banner;  // the running line ("" = none)
+    std::string toast;   // one-off notice
+    int round_result = 0;  // this tick a round ended: 1 we won it, 2 they did
+};
+
+// Every network loop. `on`: a duel challenge is on; `inviter`: we sent it (we place the duel ground).
+DuelTick duel_tick(bool on, bool inviter, bool connected, std::optional<std::array<float, 3>> me,
+                   std::optional<std::array<float, 3>> partner, const std::string& who, uint32_t now);
+
+// What the overlay draws (render/hud.cpp).
+struct DuelHud {
+    bool active = false;
+    std::array<float, 3> centre{};
+    float radius = 0;
+    std::string title;      // big centred title ("3", "Fight!", "Victory", "Defeat"; "" = none)
+    std::string subtitle;
+    unsigned int title_color = 0;
+    float title_alpha = 0;
+    float out_left_s = -1;  // seconds left to get back in the duel ground (-1 = inside)
+    float partner_hp = -1;  // the opponent's health 0..1 (-1 unknown)
+};
+DuelHud duel_hud();
+
+// [dev] duel_test: one-PC test with the echo peer: our hits on its copy of us come back as hits on us, and its echo
+// of our own "lost" is ignored.
+void duel_set_test(bool on);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_hunt.cpp b/upstream/cd-coop-3446/src/mod/net/coop_hunt.cpp
new file mode 100644
index 0000000..785e323
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_hunt.cpp
@@ -0,0 +1,215 @@
+#include "mod/net/coop_hunt.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <format>
+#include <iterator>
+#include <mutex>
+#include <vector>
+
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+#include "mod/net/enemy_relay.h"
+#include "mod/net/guest_hits.h"
+#include "mod/net/local_capture.h"
+#include "mod/net/troc_sniffer.h"
+
+namespace cdmp::net {
+namespace {
+
+struct Animal {
+    uint32_t key;
+    int points;
+    const char* name;
+};
+constexpr Animal kAnimals[] = {
+#include "mod/net/animal_names.inc"
+};
+
+const Animal* animal(uint32_t variant) {
+    const auto it = std::lower_bound(std::begin(kAnimals), std::end(kAnimals), variant,
+                                     [](const Animal& a, uint32_t k) { return a.key < k; });
+    return it != std::end(kAnimals) && it->key == variant ? it : nullptr;
+}
+
+constexpr uint16_t kOpNotifyHandleFatalAck = 2225;  // +0 victim | +4 killer
+constexpr uint16_t kOpNotifyHandleDeadAck = 2985;   // +0 victim | +4 (the victim again in the captures)
+constexpr uint64_t kOursWithinMs = 8000;            // a death within this of our last blow on it is our kill
+constexpr uint8_t kHuntType = 14;                   // Activity event type: u32 round | u16 score | u16 kills
+constexpr uint32_t kCountdownMs = 3000;
+constexpr uint32_t kRoundMs = 180000;
+constexpr uint32_t kSettleMs = 1500;  // the last scores reach both sides before the result
+constexpr uint32_t kOverMs = 8000;
+enum Phase : uint8_t { kIdle, kCountdown, kHunt, kSettle, kOver };
+
+struct State {
+    Phase phase = kIdle;
+    uint32_t round = 0, since = 0;
+    int ours = 0, theirs = 0, kills = 0, their_kills = 0;
+    int result = 0;
+    bool reported = false, send = false;
+    std::string last_kill;  // toast: "Red Deer +2"
+    uint32_t last_victim = 0;
+} g;
+std::mutex g_mutex;
+std::atomic<bool> g_test{false};
+
+}  // namespace
+
+void hunt_set_test(bool on) { g_test = on; }
+
+bool hunt_dev_kill() {
+    static std::vector<uint32_t> tried;
+    const auto loaded = enemy_loaded_variants();
+    int animals = 0;
+    for (const auto& [key, variant] : loaded) animals += animal(variant) != nullptr;
+    log::info("Hunt: [dev] {} actors loaded, {} wild animals", loaded.size(), animals);
+    int sent = 0;
+    for (const auto& [key, variant] : loaded) {
+        const Animal* a = animal(variant);
+        // Each one once (a far one gets no answer: try the next).
+        if (!a || std::find(tried.begin(), tried.end(), key) != tried.end()) continue;
+        tried.push_back(key);
+        std::vector<uint8_t> pkt(5 + 8, 0);
+        const uint16_t op = 2210, len = 8;  // KillCheatReq: u32 key | u32 option
+        std::memcpy(pkt.data(), &op, 2);
+        std::memcpy(pkt.data() + 3, &len, 2);
+        std::memcpy(pkt.data() + 5, &key, 4);
+        const bool ok = sniffer_inject_c2s(std::move(pkt));
+        log::info("Hunt: [dev] KillCheatReq on 0x{:08X} ({}){}", key, a->name, ok ? "" : " NOT sent");
+        if (++sent == 4) return ok;
+    }
+    if (sent) return true;
+    log::info("Hunt: [dev] no wild animal loaded");
+    return false;
+}
+
+void hunt_observe_s2c(const uint8_t* packet, size_t size) {
+    if (size < 5 + 8) return;
+    uint16_t op;
+    std::memcpy(&op, packet, 2);
+    if (op != kOpNotifyHandleFatalAck && op != kOpNotifyHandleDeadAck) return;
+    // NotifyHandleDeadAck (2985) is the one seen in captures, and it does not say who killed (both keys are the
+    // victim): the kill is ours when one of our blows (or arrows) named it in the last kOursWithinMs.
+    uint32_t victim, killer;
+    std::memcpy(&victim, packet + 5, 4);
+    std::memcpy(&killer, packet + 9, 4);
+    const uint32_t own = capture_own_player_key();
+    if (!own || victim == own) return;
+    if (killer != own && !guest_hits_we_hit(victim, kOursWithinMs) && !g_test) return;
+    const Animal* a = animal(enemy_variant(victim));
+    std::lock_guard lock(g_mutex);
+    if (g.phase != kHunt || victim == g.last_victim) return;  // the two notices of one death count once
+    g.last_victim = victim;
+    if (!a) {
+        log::info("Hunt: we killed 0x{:08X} (variant 0x{:08X}): not game", victim, enemy_variant(victim));
+        return;
+    }
+    g.ours += a->points;
+    g.kills += 1;
+    g.send = true;
+    g.last_kill = std::format("{} +{}", a->name, a->points);
+    log::info("Hunt: we brought down {} (+{}), score {}", a->name, a->points, g.ours);
+}
+
+void hunt_on_event(const uint8_t* d, size_t n) {
+    if (n < 8 || g_test) return;
+    uint32_t round;
+    uint16_t score, kills;
+    std::memcpy(&round, d, 4);
+    std::memcpy(&score, d + 4, 2);
+    std::memcpy(&kills, d + 6, 2);
+    std::lock_guard lock(g_mutex);
+    if (round != g.round || (g.phase != kHunt && g.phase != kSettle)) return;
+    g.theirs = score;
+    g.their_kills = kills;
+}
+
+HuntTick hunt_tick(bool on, bool connected, const std::string& who) {
+    HuntTick out;
+    const uint32_t now = GetTickCount();
+    std::vector<uint8_t> msg;
+    {
+        std::lock_guard lock(g_mutex);
+        if (!on || (!connected && !g_test)) {
+            if (g.phase != kIdle) log::info("Hunt: over");
+            g = State{};
+            return out;
+        }
+        switch (g.phase) {
+            case kIdle:
+                g.phase = kCountdown, g.since = now, g.round = 1;
+                break;
+            case kCountdown:
+                if (now - g.since >= kCountdownMs) {
+                    g.phase = kHunt, g.since = now;
+                    log::info("Hunt: round {} on", g.round);
+                }
+                break;
+            case kHunt:
+                if (now - g.since >= kRoundMs) g.phase = kSettle, g.since = now;
+                break;
+            case kSettle:
+                if (now - g.since >= kSettleMs) {
+                    g.phase = kOver, g.since = now;
+                    g.result = g.ours > g.theirs ? 1 : g.ours < g.theirs ? 2 : 3;
+                    log::info("Hunt: round {} ends {} - {}", g.round, g.ours, g.theirs);
+                }
+                break;
+            case kOver:
+                if (now - g.since >= kOverMs) {
+                    const uint32_t next = g.round + 1;
+                    g = State{};
+                    g.phase = kCountdown, g.since = now, g.round = next;
+                }
+                break;
+        }
+        if (g.send) {
+            g.send = false;
+            msg.resize(8);
+            const auto score = static_cast<uint16_t>(g.ours), kills = static_cast<uint16_t>(g.kills);
+            std::memcpy(msg.data(), &g.round, 4);
+            std::memcpy(msg.data() + 4, &score, 2);
+            std::memcpy(msg.data() + 6, &kills, 2);
+        }
+        if (!g.last_kill.empty()) out.toast = "Hunt\n" + std::exchange(g.last_kill, {});
+        if (g.phase == kOver && !g.reported) {
+            g.reported = true;
+            out.round_result = g.result;
+        }
+        if (g.phase == kHunt || g.phase == kSettle) {
+            const uint32_t left = g.phase == kHunt ? (kRoundMs - std::min(kRoundMs, now - g.since)) / 1000 : 0;
+            out.banner = std::format("Hunting contest vs {}   {}:{:02}   You {} - {} {}", who, left / 60, left % 60,
+                                     g.ours, g.theirs, who);
+        }
+    }
+    if (!msg.empty() && connected) activity_send(kHuntType, msg);
+    return out;
+}
+
+HuntHud hunt_hud() {
+    HuntHud h;
+    std::lock_guard lock(g_mutex);
+    const uint32_t t = GetTickCount() - g.since;
+    if (g.phase == kCountdown) {
+        h.title = std::to_string(std::max<uint32_t>(1, (kCountdownMs - std::min(kCountdownMs, t) + 999) / 1000));
+        h.subtitle = "Hunting contest: bring down the most game in 3 minutes (big game counts more)";
+        h.color = 0xFF82C8E8;
+        h.alpha = 1.0f - static_cast<float>(t % 1000) / 1600.0f;
+    } else if (g.phase == kHunt && t < 1200) {
+        h.title = "Hunt!";
+        h.color = 0xFF82C8E8;
+        h.alpha = 1.0f - static_cast<float>(t) / 1200.0f;
+    } else if (g.phase == kOver) {
+        h.title = g.result == 1 ? "Victory" : g.result == 2 ? "Defeat" : "A Draw";
+        h.subtitle = std::format("{} points ({} kills) to {} ({} kills)", g.ours, g.kills, g.theirs, g.their_kills);
+        h.color = g.result == 2 ? 0xFF2830C4 : 0xFF82C8E8;
+        h.alpha = t < kOverMs - 1000 ? 1.0f : std::max(0.0f, (kOverMs - t) / 1000.0f);
+    }
+    return h;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_hunt.h b/upstream/cd-coop-3446/src/mod/net/coop_hunt.h
new file mode 100644
index 0000000..411c61f
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_hunt.h
@@ -0,0 +1,49 @@
+#pragma once
+// Co-op+ hunting contest (user 2026-11-02: "other competitive minigames vs friends: target shooting..."). D44.
+//
+// The game's own shooting contests (archery at Lioncrest Manor, the firearm contest) are client-run stages against
+// an NPC and unlock through the story, so the two-player contest is the mod's, on the game's own animals: a challenge
+// game ("Hunting contest" in the picker). After 3, 2, 1, each player has kRoundMs to bring down wild animals; each
+// kill (a death notice, NotifyHandleDeadAck / NotifyHandleFatalAck, of a wild animal we hit in the last 8 s: animal_names.inc, generated
+// from the game data) scores 1 (small game), 2 (deer, foxes...) or 3 (bears, wolves, boars...). Scores go to the other
+// player as they change (Activity type 14); highest score when time runs out wins the round; then a new round.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace cdmp::net {
+
+inline constexpr uint32_t kHuntStage = 0xD0E10002;  // the challenge "stage" of a hunting contest
+
+// Our server's messages: our kills.
+void hunt_observe_s2c(const uint8_t* packet, size_t size);
+
+// Activity type 14 from the other player.
+void hunt_on_event(const uint8_t* data, size_t n);
+
+struct HuntTick {
+    std::string banner;
+    std::string toast;
+    int round_result = 0;  // this tick a round ended: 1 we won, 2 they did, 3 a draw
+};
+HuntTick hunt_tick(bool on, bool connected, const std::string& who);
+
+// The big centred title (countdown, result); "" = none.
+struct HuntHud {
+    std::string title, subtitle;
+    unsigned int color = 0;
+    float alpha = 0;
+};
+HuntHud hunt_hud();
+
+// [dev] hunt_test: one-PC test: any death we see counts as our kill (the KillCheatReq kills of the dev script name
+// no killer), and the echo of our score is ignored.
+void hunt_set_test(bool on);
+
+// [dev] script step "killgame": KillCheatReq on up to 4 loaded wild animals (false if none is loaded).
+bool hunt_dev_kill();
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_revive.cpp b/upstream/cd-coop-3446/src/mod/net/coop_revive.cpp
new file mode 100644
index 0000000..28bf511
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_revive.cpp
@@ -0,0 +1,101 @@
+#include "mod/net/coop_revive.h"
+
+#include <windows.h>
+
+#include <atomic>
+#include <cmath>
+#include <format>
+#include <mutex>
+
+#include "mod/input/actions.h"
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+#include "mod/net/revive_prompt.h"
+
+namespace cdmp::net {
+namespace {
+
+constexpr uint8_t kReviveYouType = 18;  // Activity event type (no data)
+constexpr uint32_t kBleedOutMs = 30000;
+constexpr uint32_t kHoldMs = 3000;
+constexpr float kReachM = 3.0f;
+
+std::atomic<bool> g_on{true}, g_test{false};
+std::atomic<bool> g_revived_by_partner{false};  // set by the event, consumed by the tick (network thread)
+std::mutex g_mutex;
+uint32_t g_down_since = 0;          // we are down since (0 = not)
+uint32_t g_partner_down_since = 0;  // the other player is down since
+uint32_t g_hold_since = 0;          // our hold on the revive action (0 = not holding)
+bool g_sent = false;                // our revive for this downing was sent
+
+}  // namespace
+
+void revive_partner_set(bool on, bool test) {
+    g_on = on;
+    g_test = test;
+}
+
+void revive_partner_on_event() { g_revived_by_partner = true; }
+
+ReviveTick revive_partner_tick(bool connected, float hp, float hp_max, const proto::Vec3& pos,
+                               const std::optional<ReviveRemote>& partner, const std::string& name, bool focused,
+                               uint32_t now) {
+    ReviveTick out;
+    std::lock_guard lock(g_mutex);
+    const std::string who = name.empty() ? std::string("Your friend") : name;
+    const bool we_down = hp_max > 0 && hp <= 0;
+    const bool partner_down = partner && partner->hp_max > 0 && partner->hp <= 0;
+    // Downed side.
+    if (!we_down) {
+        if (g_down_since && g_revived_by_partner.load()) out.toast = std::format("Co-op\n{} revived you", who);
+        g_down_since = 0;
+        g_revived_by_partner = false;
+    } else {
+        if (!g_down_since) g_down_since = now ? now : 1;
+        const uint32_t down_ms = now - g_down_since;
+        if (g_revived_by_partner.exchange(false)) {
+            if (g_on && connected && down_ms < kBleedOutMs + 2000 && revive_in_place(now)) {
+                log::info("Revive: {} revived us", who);
+            }
+        } else if (g_on && connected && partner && !partner_down && down_ms < kBleedOutMs) {
+            out.line = std::format("{} can revive you ({} s)", who, (kBleedOutMs - down_ms + 999) / 1000);
+        }
+    }
+    // Reviver side: the other player is down near us.
+    if (!partner_down) {
+        g_partner_down_since = 0;
+        g_hold_since = 0;
+        g_sent = false;
+        return out;
+    }
+    if (!g_partner_down_since) g_partner_down_since = now ? now : 1;
+    const bool can_revive = g_on && connected && (!we_down || g_test.load()) &&
+                            now - g_partner_down_since < kBleedOutMs && !g_sent;
+    const float dx = partner->pos.x - pos.x, dz = partner->pos.z - pos.z;
+    const bool in_reach = dx * dx + dz * dz <= kReachM * kReachM;
+    if (!can_revive || !in_reach) {
+        g_hold_since = 0;
+        if (can_revive && out.line.empty()) out.line = std::format("{} is down: go to them to revive them", who);
+        return out;
+    }
+    const bool holding = input::action_down(input::Action::ReviveFriend, focused);
+    if (!holding) {
+        g_hold_since = 0;
+        if (out.line.empty()) out.line = std::format("{{ReviveFriend}} Hold to revive {}", who);
+        return out;
+    }
+    if (!g_hold_since) g_hold_since = now ? now : 1;
+    const uint32_t held = now - g_hold_since;
+    if (held < kHoldMs) {
+        out.line = std::format("Reviving {}... {}%", who, held * 100 / kHoldMs);
+        return out;
+    }
+    g_sent = true;
+    g_hold_since = 0;
+    activity_send(kReviveYouType, {});
+    out.toast = std::format("Co-op\nYou revived {}", who);
+    log::info("Revive: we revived {}", who);
+    return out;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_revive.h b/upstream/cd-coop-3446/src/mod/net/coop_revive.h
new file mode 100644
index 0000000..ceb5f5e
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_revive.h
@@ -0,0 +1,41 @@
+#pragma once
+// Co-op+ (roadmap T15): reviving each other.
+//
+// A player who goes down while the other is alive and connected is "downed": for kBleedOutMs the other player can
+// revive them -- within kReachM of them, hold the ReviveFriend action (Shift+F7, pad View + LB) for kHoldMs. The
+// downed player then gets up where they fell with full health (revive_prompt.h: revive_in_place) and both get a
+// notice naming who revived whom. The game's own choices (Q Instant Revive, U Revive at Checkpoint) stay available
+// the whole time; after the bleed-out only they remain. Not during a boss fight's wait (boss_death_wait has its own
+// rule). [coop] teammate_revive=0 turns it off.
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "common/protocol.h"
+
+namespace cdmp::net {
+
+struct ReviveRemote {
+    float hp = 0, hp_max = 0;
+    proto::Vec3 pos;
+};
+
+struct ReviveTick {
+    std::string line;   // the reviver's hint / progress, or the downed player's bleed-out line ("" = none)
+    std::string toast;  // "You revived X" / "X revived you" ("" = none)
+};
+
+// Network loop, every pass. Our health and position; the other player's (nullopt: not connected).
+ReviveTick revive_partner_tick(bool connected, float hp, float hp_max, const proto::Vec3& pos,
+                               const std::optional<ReviveRemote>& partner, const std::string& partner_name,
+                               bool focused, uint32_t now_ms);
+
+// Activity type 18 from the other player: they revived us.
+void revive_partner_on_event();
+
+// [coop] teammate_revive; [dev] revive_test (one PC: a dead player may revive the echo copy of themselves, so the
+// whole loop runs: hold -> message -> echoed back -> revived in place).
+void revive_partner_set(bool on, bool test);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_sync.cpp b/upstream/cd-coop-3446/src/mod/net/coop_sync.cpp
new file mode 100644
index 0000000..ceb7276
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_sync.cpp
@@ -0,0 +1,98 @@
+#include "mod/net/coop_sync.h"
+
+#include <windows.h>
+
+#include <atomic>
+#include <cstring>
+#include <format>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+#include "mod/net/enemy_relay.h"
+#include "mod/net/remote_puppet.h"
+
+namespace cdmp::net {
+namespace {
+
+constexpr uint8_t kSyncType = 15;  // Activity event type: u16 copies we sent | u16 copies of theirs present here
+constexpr uint32_t kDigestMs = 10000;
+constexpr int kMismatches = 3;     // digests in a row (30 s: copies in flight settle well before)
+constexpr uint32_t kTestAfterMs = 30000;
+
+std::mutex g_mutex;
+bool g_was_connected = false;
+uint32_t g_connected_at = 0, g_last_digest = 0;
+int g_misses = 0;
+std::string g_resync;
+bool g_test_done = false;
+std::atomic<int> g_test{0};
+
+}  // namespace
+
+void sync_set_test(int mode) { g_test = mode; }
+
+void sync_tick(bool connected, uint32_t now) {
+    std::vector<uint8_t> digest;
+    bool induce = false;
+    {
+        std::lock_guard lock(g_mutex);
+        if (connected != g_was_connected) {
+            g_was_connected = connected;
+            g_connected_at = now;
+            g_last_digest = now;
+            g_misses = 0;
+            g_test_done = false;
+        }
+        if (!connected) return;
+        if (now - g_last_digest >= kDigestMs) {
+            g_last_digest = now;
+            const auto sent = static_cast<uint16_t>(enemy_copies_sent());
+            const auto present = static_cast<uint16_t>(enemy_copies_present());
+            digest.resize(4);
+            std::memcpy(digest.data(), &sent, 2);
+            std::memcpy(digest.data() + 2, &present, 2);
+        }
+        if (g_test.load() > 0 && !g_test_done && now - g_connected_at >= kTestAfterMs) {
+            g_test_done = true;
+            induce = true;
+        }
+    }
+    if (!digest.empty()) activity_send(kSyncType, digest);
+    if (induce) {
+        const bool both = g_test.load() == 1;
+        const bool removed = both && enemy_desync_test();
+        puppet_set_frozen_ms(both ? 25000 : 60000);
+        log::info("Sync: [dev] desync induced (enemy copy removed: {}, the other player's character frozen {} s)",
+                  removed ? "yes" : "no", both ? 25 : 60);
+    }
+}
+
+void sync_on_event(const uint8_t* d, size_t n) {
+    if (n < 4) return;
+    uint16_t their_sent = 0;
+    std::memcpy(&their_sent, d, 2);
+    const size_t present = enemy_copies_present();
+    std::lock_guard lock(g_mutex);
+    if (their_sent == present) {
+        if (g_misses) log::info("Sync: enemy copies in step again ({})", present);
+        g_misses = 0;
+        return;
+    }
+    ++g_misses;
+    log::info("Sync: the other player sent {} enemy copies, {} are here ({} digest{} in a row)", their_sent, present,
+              g_misses, g_misses == 1 ? "" : "s");
+    if (g_misses >= kMismatches && g_resync.empty()) {
+        g_resync = std::format("their enemies: {} sent, {} here", their_sent, present);
+        g_misses = 0;
+    }
+}
+
+std::string sync_take_resync() {
+    std::lock_guard lock(g_mutex);
+    return std::exchange(g_resync, {});
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_sync.h b/upstream/cd-coop-3446/src/mod/net/coop_sync.h
new file mode 100644
index 0000000..e84a9b3
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_sync.h
@@ -0,0 +1,31 @@
+#pragma once
+// Co-op+ (roadmap T06): desync detection and resync.
+//
+// Every kDigestMs each side sends a digest (Activity type 15): how many enemy copies it sent the other player and how
+// many copies of the other player's enemies it has in its world right now (loaded, or waiting to load). When the
+// other side's "sent" and our "present" disagree on kMismatches digests in a row, we ask for a resync: the session is
+// dropped and joined again (the reconnection path verified in T04: every copy removed, sent again once). The other
+// player's character drawn far from where they say they are is reloaded locally (coop.cpp). Time and weather are
+// resent all the time by their own modules. A manual resync is the Resync action (Shift+F8 / View + RB).
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace cdmp::net {
+
+// Network loop, every tick.
+void sync_tick(bool connected, uint32_t now_ms);
+
+// Activity type 15 from the other player.
+void sync_on_event(const uint8_t* data, size_t n);
+
+// A resync the digests asked for ("" = none): the reason, once.
+std::string sync_take_resync();
+
+// [dev] desync_test: 30 s after each connection, 1 = one copy of the other player's enemies is removed from our
+// world behind the relay's back and the other player's character stops following them for 25 s; 2 = only the
+// character, frozen for 60 s (the drift check).
+void sync_set_test(int mode);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_travel.cpp b/upstream/cd-coop-3446/src/mod/net/coop_travel.cpp
new file mode 100644
index 0000000..f026aba
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_travel.cpp
@@ -0,0 +1,101 @@
+#include "mod/net/coop_travel.h"
+
+#include <windows.h>
+
+#include <cmath>
+#include <format>
+#include <mutex>
+#include <vector>
+
+#include "mod/input/actions.h"
+#include "mod/log.h"
+#include "mod/net/coop_activity.h"
+
+namespace cdmp::net {
+namespace {
+
+constexpr uint8_t kTravelType = 20;  // Activity event type: u8 kind
+constexpr uint8_t kSummon = 1, kTravelled = 2;
+constexpr uint32_t kRequestMs = 20000;
+constexpr uint32_t kCooldownMs = 30000;
+constexpr float kTravelM = 250.0f;     // covered within kTravelWindowMs = a fast travel or a long trip
+constexpr uint32_t kTravelWindowMs = 5000;
+constexpr float kArrivedM = 6.0f;      // the request is answered once we stand this close to them
+
+std::mutex g_mutex;
+uint8_t g_pending = 0;         // their request (0 = none)
+uint32_t g_pending_at = 0;
+uint32_t g_summoned_at = 0;    // our last summon
+std::optional<proto::Vec3> g_anchor;  // our position kTravelWindowMs ago
+uint32_t g_anchor_at = 0;
+
+float dist2(const proto::Vec3& a, const proto::Vec3& b) {
+    const float dx = a.x - b.x, dz = a.z - b.z;
+    return dx * dx + dz * dz;
+}
+
+}  // namespace
+
+void travel_on_event(const uint8_t* d, size_t n) {
+    if (n < 1 || (d[0] != kSummon && d[0] != kTravelled)) return;
+    std::lock_guard lock(g_mutex);
+    g_pending = d[0];
+    g_pending_at = GetTickCount();
+}
+
+TravelTick travel_tick(bool connected, const std::optional<proto::Vec3>& me, const std::optional<proto::Vec3>& partner,
+                       const std::string& name, bool focused, uint32_t now) {
+    TravelTick out;
+    const std::string who = name.empty() ? std::string("Your friend") : name;
+    static input::Edge summon_key;
+    const bool summon = summon_key(input::action_down(input::Action::Summon, focused));
+    std::vector<uint8_t> send;
+    {
+        std::lock_guard lock(g_mutex);
+        if (!connected) {
+            g_pending = 0;
+            g_anchor.reset();
+            return out;
+        }
+        // Our summon.
+        if (summon) {
+            if (g_summoned_at && now - g_summoned_at < kCooldownMs) {
+                out.toast = std::format("Co-op\nYou can call {} again in {} s", who,
+                                        (kCooldownMs - (now - g_summoned_at) + 999) / 1000);
+            } else if (partner && me && dist2(*partner, *me) < kArrivedM * kArrivedM) {
+                out.toast = std::format("Co-op\n{} is already with you", who);
+            } else {
+                g_summoned_at = now ? now : 1;
+                send = {kSummon};
+                out.toast = std::format("Co-op\nYou asked {} to come to you", who);
+                log::info("Travel: we summon {}", who);
+            }
+        }
+        // Our own long trip.
+        if (me) {
+            if (!g_anchor || now - g_anchor_at > kTravelWindowMs) {
+                if (g_anchor && dist2(*g_anchor, *me) > kTravelM * kTravelM && send.empty()) {
+                    send = {kTravelled};
+                    log::info("Travel: we travelled {:.0f} m: telling {}", std::sqrt(dist2(*g_anchor, *me)), who);
+                }
+                g_anchor = me;
+                g_anchor_at = now;
+            }
+        }
+        // Their request.
+        if (g_pending) {
+            const bool arrived = partner && me && dist2(*partner, *me) < kArrivedM * kArrivedM;
+            if (arrived || now - g_pending_at > kRequestMs) {
+                g_pending = 0;
+            } else {
+                out.line = g_pending == kSummon
+                               ? std::format("{} asks you to come to them:   {{GoToFriend}} go", who)
+                               : std::format("{} travelled far away:   {{GoToFriend}} follow them", who);
+            }
+        }
+    }
+    if (!send.empty()) activity_send(kTravelType, send);
+    return out;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/coop_travel.h b/upstream/cd-coop-3446/src/mod/net/coop_travel.h
new file mode 100644
index 0000000..39246ae
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/coop_travel.h
@@ -0,0 +1,31 @@
+#pragma once
+// Co-op+ (roadmap T19): summoning and party travel, both with consent.
+//
+// Summon: the Summon action (Shift+F4, pad View + right stick click) asks the other player to come; they get a line
+// "<name> asks you to come to them: {GoToFriend} go" for kRequestMs and answer with their own go-to (Ctrl+F4, the
+// hop teleport that lands beside the other player: never under ground, D31/D34), or let it lapse. kCooldownMs
+// between summons. Party travel: when we cover more than kTravelM within a few seconds (fast travel, a long trip),
+// the other player gets "<name> travelled far: {GoToFriend} follow them". Activity type 20: u8 kind (1 summon,
+// 2 travelled).
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "common/protocol.h"
+
+namespace cdmp::net {
+
+struct TravelTick {
+    std::string line;   // the request on our screen ("" = none)
+    std::string toast;  // "Summon sent" / "wait N s" ...
+};
+// Network loop. `me`: our position (nullopt: not in the world). `partner`: theirs (nullopt: not connected).
+TravelTick travel_tick(bool connected, const std::optional<proto::Vec3>& me,
+                       const std::optional<proto::Vec3>& partner, const std::string& partner_name, bool focused,
+                       uint32_t now_ms);
+
+// Activity type 20 from the other player.
+void travel_on_event(const uint8_t* data, size_t n);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_script.cpp b/upstream/cd-coop-3446/src/mod/net/dev_script.cpp
new file mode 100644
index 0000000..af18203
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_script.cpp
@@ -0,0 +1,216 @@
+#include "mod/net/dev_script.h"
+#include "mod/input/pad_input.h"
+
+#include <windows.h>
+
+#include <cctype>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <thread>
+#include <vector>
+
+#include "mod/log.h"
+#include "mod/net/local_capture.h"
+#include "mod/net/remote_puppet.h"
+#include "mod/net/revive_prompt.h"
+#include "mod/net/time_sync.h"
+#include "mod/net/dev_watch.h"
+#include "mod/net/coop_hunt.h"
+#include "mod/net/troc_sniffer.h"
+
+namespace cdmp::net {
+namespace {
+
+struct Step {
+    enum Kind { C2S, S2C, Wait, Teleport, Poke, Time, Watch, Day, Pad, KillGame } kind;
+    uintptr_t addr = 0;
+    float to[3] = {};
+    uint16_t op = 0;
+    std::vector<uint8_t> payload;
+    uint32_t wait_ms = 0;
+};
+
+std::string hex_of(const void* p, size_t n) {
+    static const char* d = "0123456789abcdef";
+    std::string s;
+    for (size_t i = 0; i < n; ++i) {
+        const uint8_t b = static_cast<const uint8_t*>(p)[i];
+        s += d[b >> 4];
+        s += d[b & 15];
+    }
+    return s;
+}
+
+void replace_all(std::string& s, const std::string& from, const std::string& to) {
+    for (size_t at = s.find(from); at != std::string::npos; at = s.find(from, at + to.size())) s.replace(at, from.size(), to);
+}
+
+bool parse_hex(const std::string& in, std::vector<uint8_t>& out) {
+    std::string h;
+    for (char c : in)
+        if (std::isxdigit(static_cast<unsigned char>(c))) h += c;
+        else if (!std::isspace(static_cast<unsigned char>(c))) return false;
+    if (h.size() % 2) return false;
+    for (size_t i = 0; i < h.size(); i += 2) out.push_back(static_cast<uint8_t>(std::stoul(h.substr(i, 2), nullptr, 16)));
+    return true;
+}
+
+std::vector<uint8_t> make_c2s(uint16_t op, const std::vector<uint8_t>& payload) {
+    std::vector<uint8_t> pkt(5 + payload.size());
+    const uint16_t len = static_cast<uint16_t>(payload.size());
+    std::memcpy(pkt.data(), &op, 2);
+    pkt[2] = 0;
+    std::memcpy(pkt.data() + 3, &len, 2);
+    if (!payload.empty()) std::memcpy(pkt.data() + 5, payload.data(), payload.size());
+    return pkt;
+}
+
+}  // namespace
+
+int dev_script_run(const std::string& path, uint32_t own_player, float x, float y, float z) {
+    std::ifstream f(path);
+    if (!f) {
+        log::warn("Dev script: cannot read {}", path);
+        return -1;
+    }
+    const uint32_t user = capture_own_user_key();
+    const float pos[3] = {x, y, z};
+    std::vector<Step> steps;
+    std::string line;
+    int lineno = 0;
+    while (std::getline(f, line)) {
+        ++lineno;
+        if (const auto hash = line.find('#'); hash != std::string::npos) line.resize(hash);
+        std::istringstream in(line);
+        std::string kind;
+        if (!(in >> kind)) continue;
+        Step st{};
+        if (kind == "wait") {
+            in >> st.wait_ms;
+            st.kind = Step::Wait;
+            st.wait_ms = std::min<uint32_t>(st.wait_ms, 10000);
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "watch") {
+            std::string a;
+            int len = 4, hits = 8;
+            in >> a >> len >> hits;
+            st.kind = Step::Watch;
+            st.addr = static_cast<uintptr_t>(std::stoull(a, nullptr, 16));
+            st.to[0] = static_cast<float>(len ? len : 4);
+            st.to[1] = static_cast<float>(hits ? hits : 8);
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "pad") {  // pad <hex buttons (input/pad_input.h)> <ms>: a simulated pad press
+            std::string b;
+            in >> b >> st.wait_ms;
+            st.kind = Step::Pad;
+            st.addr = static_cast<uintptr_t>(std::stoul(b, nullptr, 16));
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "killgame") {  // killgame: KillCheatReq on a loaded wild animal (coop_hunt.h)
+            st.kind = Step::KillGame;
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "day") {
+            st.kind = Step::Day;
+            in >> st.to[0];
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "time") {
+            char colon = 0;
+            if (!(in >> st.to[0] >> colon >> st.to[1]) || colon != ':') {
+                log::warn("Dev script: line {} needs time hh:mm", lineno);
+                continue;
+            }
+            st.kind = Step::Time;
+            steps.push_back(st);
+            continue;
+        }
+        if (kind == "poke") {
+            std::string a, rest;
+            in >> a;
+            std::getline(in, rest);
+            st.kind = Step::Poke;
+            st.addr = static_cast<uintptr_t>(std::stoull(a, nullptr, 16));
+            if (!st.addr || !parse_hex(rest, st.payload) || st.payload.empty()) {
+                log::warn("Dev script: line {} needs poke <hex address> <hex bytes>", lineno);
+                continue;
+            }
+            steps.push_back(std::move(st));
+            continue;
+        }
+        if (kind == "tp") {
+            st.kind = Step::Teleport;
+            if (!(in >> st.to[0] >> st.to[1] >> st.to[2])) {
+                log::warn("Dev script: line {} needs tp x y z", lineno);
+                continue;
+            }
+            steps.push_back(st);
+            continue;
+        }
+        unsigned op = 0;
+        if ((kind != "c2s" && kind != "s2c") || !(in >> op)) {
+            log::warn("Dev script: line {} not understood", lineno);
+            continue;
+        }
+        std::string rest;
+        std::getline(in, rest);
+        replace_all(rest, "{P}", hex_of(&own_player, 4));
+        replace_all(rest, "{U}", hex_of(&user, 4));
+        replace_all(rest, "{POS}", hex_of(pos, 12));
+        if (!parse_hex(rest, st.payload)) {
+            log::warn("Dev script: line {} has a bad hex payload", lineno);
+            continue;
+        }
+        st.kind = kind == "c2s" ? Step::C2S : Step::S2C;
+        st.op = static_cast<uint16_t>(op);
+        steps.push_back(std::move(st));
+    }
+    int packets = 0;
+    for (const auto& st : steps) packets += st.kind != Step::Wait;
+    log::info("Dev script: {} packets from {}", packets, path);
+    std::thread([steps = std::move(steps)] {
+        for (const auto& st : steps) {
+            if (st.kind == Step::Wait) {
+                Sleep(st.wait_ms);
+            } else if (st.kind == Step::Watch) {
+                dev_watch_start(st.addr, static_cast<int>(st.to[0]), static_cast<int>(st.to[1]));
+            } else if (st.kind == Step::Pad) {
+                input::dev_pad_press(static_cast<uint16_t>(st.addr), st.wait_ms ? st.wait_ms : 150);
+                log::info("Dev script: pad 0x{:04X} for {} ms", st.addr, st.wait_ms);
+                Sleep(st.wait_ms ? st.wait_ms : 150);
+            } else if (st.kind == Step::KillGame) {
+                hunt_dev_kill();
+            } else if (st.kind == Step::Day) {
+                time_sync_dev_add_days(static_cast<int>(st.to[0]));
+            } else if (st.kind == Step::Time) {
+                time_sync_dev_set(static_cast<int>(st.to[0]), static_cast<int>(st.to[1]));
+            } else if (st.kind == Step::Poke) {
+                MEMORY_BASIC_INFORMATION mbi{};
+                const bool ok = VirtualQuery(reinterpret_cast<void*>(st.addr), &mbi, sizeof mbi) &&
+                                mbi.State == MEM_COMMIT && (mbi.Protect & (PAGE_READWRITE | PAGE_EXECUTE_READWRITE));
+                if (ok) std::memcpy(reinterpret_cast<void*>(st.addr), st.payload.data(), st.payload.size());
+                log::info("Dev script: poke 0x{:X} ({} bytes){}", st.addr, st.payload.size(), ok ? "" : " REFUSED (not writable)");
+            } else if (st.kind == Step::Teleport) {
+                revive_teleport_to(st.to[0], st.to[1], st.to[2]);
+                log::info("Dev script: teleport to ({:.0f}, {:.0f}, {:.0f})", st.to[0], st.to[1], st.to[2]);
+            } else if (st.kind == Step::C2S) {
+                const bool ok = sniffer_inject_c2s(make_c2s(st.op, st.payload));
+                log::info("Dev script: c2s {} ({} bytes){}", st.op, st.payload.size(), ok ? "" : " NOT sent");
+            } else {
+                puppet_inject_s2c_batch({{st.op, st.payload}});
+                log::info("Dev script: s2c {} ({} bytes)", st.op, st.payload.size());
+            }
+        }
+    }).detach();
+    return packets;
+}
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_script.h b/upstream/cd-coop-3446/src/mod/net/dev_script.h
new file mode 100644
index 0000000..bb975ca
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_script.h
@@ -0,0 +1,27 @@
+#pragma once
+// Co-op+ dev: send hand-written Troc packets from a text file (research on one PC: dev stage/minigame requests,
+// sequencer messages). Bound to Ctrl+Shift+F6 when [dev] script=<path> is set. Never used in normal play.
+//
+// File format, one packet per line ('#' starts a comment, blank lines skipped):
+//   c2s <opcode> <hex payload>     (injected as if the client sent it)
+//   s2c <opcode> <hex payload>     (injected as if the server sent it)
+//   wait <ms>                      (pause before the next line, at most 10 s)
+//   tp <x> <y> <z>                 (move our player there with the hopped teleport, revive_prompt.h)
+//   poke <hex address> <hex bytes>  (write game memory: research only; the page must be writable)
+//   time <hh:mm>                   (set our time of day, time_sync.h)
+//   day <+N>                       (N days later, same hour)
+//   watch <hex addr> [len] [hits]  (hardware write breakpoint, dev_watch.h; logs who writes it)
+//   pad <hex buttons> <ms>         (a simulated pad press, input/pad_input.h; e.g. pad 0021 300 = View + D-pad Up)
+// Placeholders in the payload: {P} = our player key (u32), {POS} = our position (3 x f32), {U} = our user key (u32).
+// Spaces inside the hex are ignored. Opcodes are decimal.
+
+#include <cstdint>
+#include <string>
+
+namespace cdmp::net {
+
+// Runs the file on a worker thread (so "wait" never blocks the network loop). Returns the number of packets queued,
+// or -1 when the file cannot be read.
+int dev_script_run(const std::string& path, uint32_t own_player, float x, float y, float z);
+
+}  // namespace cdmp::net
diff --git a/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp b/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp
new file mode 100644
index 0000000..b8443f6
--- /dev/null
+++ b/upstream/cd-coop-3446/src/mod/net/dev_watch.cpp
@@ -0,0 +1,125 @@
+#include "mod/net/dev_watch.h"
+
+#include <windows.h>
+#include <tlhelp32.h>
+
+#include <atomic>
+#include <cstring>
+#include <format>
+#include <string>
+#include <thread>
+
+#include "mod/log.h"
+
+namespace cdmp::net {
+namespace {
+
+struct Hit {
+    uint64_t rip, regs[16];
+    float xmm0, xmm1;
+    uint64_t stack[64];  // the first 64 qwords at rsp (return addresses among them)
+};
+
+constexpr int kMaxHits = 16;
+Hit g_hits[kMaxHits];
+std::atomic<int> g_count{0};
+std::atomic<int> g_want{0};
+std::atomic<bool> g_armed{false};
+PVOID g_handler = nullptr;
+
+LONG CALLBACK on_exception(EXCEPTION_POINTERS* e) {
+    if (e->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP || !(e->ContextRecord->Dr6 & 1)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    CONTEXT* c = e->ContextRecord;
+    c->Dr6 = 0;
+    if (g_armed.load()) {
+        const int i = g_count.fetch_add(1);
+        if (i < kMaxHits && i < g_want.load()) {
+            Hit& h = g_hits[i];
+            h.rip = c->Rip;
+            const uint64_t r[16] = {c->Rax, c->Rcx, c->Rdx, c->Rbx, c->Rsp, c->Rbp, c->Rsi, c->Rdi,
+                                    c->R8,  c->R9,  c->R10, c->R11, c->R12, c->R13, c->R14, c->R15};
+            std::memcpy(h.regs, r, sizeof r);
+            std::memcpy(&h.xmm0, &c->Xmm0, 4);
+            std::memcpy(&h.xmm1, &c->Xmm1, 4);
+            std::memcpy(h.stack, reinterpret_cast<const void*>(c->Rsp), sizeof h.stack);  // our own thread's stack
+        }
+        if (i + 1 >= g_want.load()) c->Dr7 &= ~1ull;  // this thread stops; the others are cleared by the worker
+    } else {
+        c->Dr7 &= ~1ull;
+    }
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+// Dr0 = addr and its enable bits on every thread of the game except the caller.
+void set_all(uintptr_t addr, int len, bool on) {
+    const DWORD me = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap == INVALID_HANDLE_VALUE) return;
+    THREADENTRY32 te{sizeof te};
+    const uint64_t lenbits = len == 1 ? 0 : len == 2 ? 1 : len == 8 ? 2 : 3;
+    int n = 0;
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
